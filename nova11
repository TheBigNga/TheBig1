function Library:Notify(o)
    o = o or {}
    self.NotifCount = self.NotifCount + 1

    local kinds = {
        info    = { color = Color3.fromRGB(128, 170, 230), tag = "INFO" },
        success = { color = Color3.fromRGB(132, 196, 152), tag = "OK" },
        warning = { color = Color3.fromRGB(226, 186, 110), tag = "WARN" },
        error   = { color = Color3.fromRGB(218, 124, 116), tag = "ERROR" },
    }
    local kind = kinds[o.Type or "info"] or kinds.info
    local accent = o.Color or kind.color
    local title = tostring(o.Title or "Lib Fac!")
    local text = o.Text or o.Description
    local dur = tonumber(o.Duration) or 4
    local tag = o.Tag or kind.tag

    local container = New("Frame", {
        Size = UD2(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, LayoutOrder = self.NotifCount,
    }, self.NotifHolder)

    local card = New("TextButton", {
        Position = OFF(320, 0), Size = UD2(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, Text = "", AutoButtonColor = false,
        ClipsDescendants = true,
    }, container)
    Corner(8, card)
    self:Bind(card, "BackgroundColor3", "Surface")
    local cardStroke = Stroke(card, "Stroke", 1, 0.2)

    local dot = New("Frame", {
        Position = OFF(14, 16), Size = OFF(6, 6), BackgroundColor3 = accent,
    }, card)
    Corner(3, dot)

    local body = New("Frame", {
        Size = UD2(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
    }, card)
    Pad(body, 12, 14, 30, 14)
    VList(body, 4)

    local header = New("Frame", { Size = UD2(1, 0, 0, 16), BackgroundTransparency = 1, LayoutOrder = 1 }, body)
    local titleL = New("TextLabel", {
        BackgroundTransparency = 1, Size = UD2(1, -60, 1, 0), Text = title,
        Font = FONT_BOLD, TextSize = 13, TextXAlignment = LEFT, TextTruncate = TRUNC,
    }, header)
    if o.Color then titleL.TextColor3 = accent else self:Bind(titleL, "TextColor3", "Text") end
    New("TextLabel", {
        AnchorPoint = V2(1, 0), Position = UD2(1, 0, 0, 1), Size = OFF(60, 14),
        BackgroundTransparency = 1, Text = tag, Font = FONT, TextSize = 9,
        TextColor3 = accent, TextXAlignment = RIGHT,
    }, header)

    if text then
        local msg = New("TextLabel", {
            Size = UD2(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2,
            BackgroundTransparency = 1, Text = tostring(text), Font = FONT_TEXT, TextSize = 12,
            TextWrapped = true, TextXAlignment = LEFT, TextYAlignment = Enum.TextYAlignment.Top,
        }, body)
        self:Bind(msg, "TextColor3", "SubText")
    end

    local track = New("Frame", {
        AnchorPoint = V2(0, 1), Position = UD2(0, 0, 1, 0), Size = UD2(1, 0, 0, 2),
        BackgroundTransparency = 1,
    }, card)
    local bar = New("Frame", { Size = UD2(1, 0, 1, 0), BackgroundColor3 = accent }, track)
    Corner(1, bar)

    Tween(card, { Position = OFF(0, 0) }, 0.45, ES.Back)
    Tween(bar, { Size = UD2(0, 0, 1, 0) }, dur, ES.Linear, ED.InOut)

    card.MouseEnter:Connect(function() Tween(cardStroke, { Transparency = 0, Color = accent }, 0.2) end)
    card.MouseLeave:Connect(function() Tween(cardStroke, { Transparency = 0.2, Color = self.Theme.Stroke }, 0.25) end)

    local closed = false
    local function close()
        if closed then return end
        closed = true
        Tween(card, { Position = OFF(320, 0) }, 0.3, ES.Quint, ED.In)
        task.delay(0.28, function()
            if not container.Parent then return end
            local h = container.AbsoluteSize.Y
            container.AutomaticSize = Enum.AutomaticSize.None
            container.Size = UD2(1, 0, 0, h)
            container.ClipsDescendants = true
            local tw = Tween(container, { Size = UD2(1, 0, 0, 0) }, 0.25, ES.Quint)
            tw.Completed:Connect(function()
                if container.Parent then container:Destroy() end
            end)
        end)
    end
    card.MouseButton1Click:Connect(close)
    task.delay(dur, close)
end
