function SectionMT:Colorpicker(o)
    o = o or {}
    local lib = self.Window.Library
    local C = {
        Flag = o.Flag or lib:NextFlag(),
        Callback = o.Callback or function() end,
        Color = WHITE,
    }
    local h, s, v = (o.Default or lib.Theme.Accent):ToHSV()
    local dragging = nil

    local PANEL_H = 110 + 6 + 10 + 6 + 22
    local CLIP_H = PANEL_H + 2

    self.Count = self.Count + 1
    local holder = New("Frame", {
        Size = UD2(1, 0, 0, 18), BackgroundTransparency = 1, LayoutOrder = self.Count,
    }, self.Body)

    local head = New("TextButton", {
        Size = UD2(1, 0, 0, 18), BackgroundTransparency = 1, Text = "",
        AutoButtonColor = false,
    }, holder)
    local nameL = New("TextLabel", {
        BackgroundTransparency = 1, Size = UD2(1, -40, 1, 0), Text = tostring(o.Name or "color"),
        Font = FONT_TEXT, TextSize = 13, TextXAlignment = LEFT, TextTruncate = TRUNC,
    }, head)
    lib:Bind(nameL, "TextColor3", "Text")

    local swatch = New("Frame", {
        AnchorPoint = V2(1, 0.5), Position = UD2(1, 0, 0.5, 0), Size = OFF(30, 14),
    }, head)
    Corner(4, swatch)
    local swatchStroke = Stroke(swatch, "Stroke")

    local clip = New("Frame", {
        Position = OFF(0, 24), Size = UD2(1, 0, 0, 0),
        BackgroundTransparency = 1, ClipsDescendants = true,
    }, holder)

    local panel = New("Frame", {
        Position = OFF(1, 1), Size = UD2(1, -2, 0, PANEL_H), BackgroundTransparency = 1,
    }, clip)
    VList(panel, 6)

    local sv = New("TextButton", {
        Size = UD2(1, 0, 0, 110), Text = "", AutoButtonColor = false,
        ClipsDescendants = true, LayoutOrder = 0,
    }, panel)
    Corner(6, sv)
    Stroke(sv, "Stroke")

    local white = New("Frame", { Size = UD2(1, 0, 1, 0), BackgroundColor3 = WHITE }, sv)
    New("UIGradient", { Transparency = NumberSequence.new(0, 1), Rotation = 0 }, white)

    local black = New("Frame", { Size = UD2(1, 0, 1, 0), BackgroundColor3 = BLACK }, sv)
    New("UIGradient", { Transparency = NumberSequence.new(1, 0), Rotation = 90 }, black)

    local svCur = New("Frame", {
        AnchorPoint = V2(0.5, 0.5), Size = OFF(8, 8), BackgroundTransparency = 1,
    }, sv)
    Corner(4, svCur)
    New("UIStroke", { Thickness = 1.5, Color = WHITE, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, svCur)

    local hue = New("TextButton", {
        Size = UD2(1, 0, 0, 10), Text = "", AutoButtonColor = false, LayoutOrder = 1,
    }, panel)
    Corner(3, hue)
    local hueKeys = {}
    for i = 0, 6 do
        table.insert(hueKeys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 1, 1)))
    end
    New("UIGradient", { Color = ColorSequence.new(hueKeys) }, hue)

    local hueCur = New("Frame", {
        AnchorPoint = V2(0.5, 0.5), Size = OFF(4, 14), BackgroundColor3 = WHITE,
    }, hue)
    Corner(2, hueCur)
    New("UIStroke", { Thickness = 1, Color = BLACK, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, hueCur)

    local hexRow = New("Frame", {
        Size = UD2(1, 0, 0, 22), BackgroundTransparency = 1, LayoutOrder = 2,
    }, panel)
    local hexL = New("TextLabel", {
        BackgroundTransparency = 1, Size = UD2(0.3, 0, 1, 0), Text = "hex",
        Font = FONT, TextSize = 10, TextXAlignment = LEFT,
    }, hexRow)
    lib:Bind(hexL, "TextColor3", "SubText")

    local hexBox = New("TextBox", {
        Position = UD2(0.3, 0, 0, 0), Size = UD2(0.7, 0, 1, 0),
        Text = "", Font = FONT, TextSize = 11, ClearTextOnFocus = false,
        TextXAlignment = LEFT,
    }, hexRow)
    Corner(6, hexBox)
    Pad(hexBox, 0, 0, 8, 8)
    lib:Bind(hexBox, { BackgroundColor3 = "Element", TextColor3 = "Text" })

    local function paint(silent, smooth)
        local col = Color3.fromHSV(h, s, v)
        C.Color = col
        sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        swatch.BackgroundColor3 = col
        if smooth then
            Tween(svCur, { Position = UD2(s, 0, 1 - v, 0) }, 0.2)
            Tween(hueCur, { Position = UD2(h, 0, 0.5, 0) }, 0.2)
        else
            svCur.Position = UD2(s, 0, 1 - v, 0)
            hueCur.Position = UD2(h, 0, 0.5, 0)
        end
        hexBox.Text = "#" .. col:ToHex():upper()
        lib.Flags[C.Flag] = col
        if not silent then lib:SafeCall(C.Callback, col) end
    end

    local function setColor(col, silent)
        if type(col) == "string" then
            local ok, parsed = pcall(Color3.fromHex, col)
            if not ok then return end
            col = parsed
        end
        if typeof(col) ~= "Color3" then return end
        h, s, v = col:ToHSV()
        paint(silent, true)
    end

    local function bindDrag(area, fn)
        area.InputBegan:Connect(function(i)
            if i.UserInputType == MB1 or i.UserInputType == TOUCH then
                dragging = fn
                fn(i.Position)
            end
        end)
    end
    lib:Connect(UIS.InputChanged, function(i)
        if dragging and (i.UserInputType == MOVE or i.UserInputType == TOUCH) then
            dragging(i.Position)
        end
    end)
    lib:Connect(UIS.InputEnded, function(i)
        if i.UserInputType == MB1 or i.UserInputType == TOUCH then dragging = nil end
    end)

    bindDrag(sv, function(p)
        local w, hg = sv.AbsoluteSize.X, sv.AbsoluteSize.Y
        if w <= 0 or hg <= 0 then return end
        s = math.clamp((p.X - sv.AbsolutePosition.X) / w, 0, 1)
        v = 1 - math.clamp((p.Y - sv.AbsolutePosition.Y) / hg, 0, 1)
        paint()
    end)

    bindDrag(hue, function(p)
        local w = hue.AbsoluteSize.X
        if w <= 0 then return end
        h = math.clamp((p.X - hue.AbsolutePosition.X) / w, 0, 1)
        paint()
    end)

    hexBox.FocusLost:Connect(function()
        local ok, col = pcall(Color3.fromHex, hexBox.Text)
        if ok then
            h, s, v = col:ToHSV()
            paint(false, true)
        else
            paint(true, true)
        end
    end)

    local open = false
    head.MouseEnter:Connect(function() Tween(swatch, { Size = OFF(34, 16) }, 0.2, ES.Back) end)
    head.MouseLeave:Connect(function() Tween(swatch, { Size = OFF(30, 14) }, 0.25) end)
    head.MouseButton1Click:Connect(function()
        open = not open
        local ch = open and CLIP_H or 0
        Tween(clip, { Size = UD2(1, 0, 0, ch) }, 0.4)
        Tween(holder, { Size = UD2(1, 0, 0, open and (18 + 6 + ch) or 18) }, 0.4)
        Tween(swatchStroke, { Color = open and lib.Theme.Accent or lib.Theme.Stroke }, 0.2)
    end)

    setColor(o.Default or lib.Theme.Accent, true)
    lib.Setters[C.Flag] = function(col, silent) setColor(col, silent) end

    return {
        Set = function(col, silent) setColor(col, silent) end,
        Get = function() return C.Color end,
    }
end

---------------------------------------------------------------------
-- Keybind
---------------------------------------------------------------------
function SectionMT:Keybind(o)
    o = o or {}
    local lib = self.Window.Library
    local K = {
        Name = tostring(o.Name or "keybind"),
        Flag = o.Flag or lib:NextFlag(),
        Callback = o.Callback or function() end,
        Value = o.Value,
        Show = o.Show ~= false,
        Key = nil,
        Waiting = false,
        Row = nil,
    }

    local row = NextRow(self, 24)

    local nameL = New("TextLabel", {
        BackgroundTransparency = 1, Size = UD2(1, -100, 1, 0), Text = K.Name,
        Font = FONT_TEXT, TextSize = 13, TextXAlignment = LEFT, TextTruncate = TRUNC,
    }, row)
    lib:Bind(nameL, "TextColor3", "Text")

    local btn = New("TextButton", {
        AnchorPoint = V2(1, 0.5), Position = UD2(1, 0, 0.5, 0), Size = OFF(90, 22),
        Text = "none", Font = FONT, TextSize = 10, AutoButtonColor = false,
    }, row)
    Corner(6, btn)
    lib:Bind(btn, { BackgroundColor3 = "Element" })
    local btnStroke = Stroke(btn, "Stroke")
    local btnScale = New("UIScale", { Scale = 1 }, btn)

    local function refreshBtn()
        if K.Waiting then
            btn.Text = "press key"
            Tween(btn, { TextColor3 = lib.Theme.Accent }, 0.15)
            Tween(btnStroke, { Color = lib.Theme.Accent }, 0.2)
        else
            btn.Text = K.Key and K.Key.Name or "none"
            Tween(btn, { TextColor3 = K.Key and lib.Theme.Text or lib.Theme.SubText }, 0.15)
            Tween(btnStroke, { Color = lib.Theme.Stroke }, 0.25)
        end
    end

    function K:Set(key, silent)
        if type(key) == "string" then
            key = Enum.KeyCode[key]
        end
        K.Key = typeof(key) == "EnumItem" and key or nil
        lib.Flags[K.Flag] = K.Key and K.Key.Name or nil
        refreshBtn()
        lib:_UpdateKeyRow(K)
        if not silent then
            lib:SafeCall(K.Callback, K.Key)
            btnScale.Scale = 0.92
            Tween(btnScale, { Scale = 1 }, 0.4, ES.Back)
        end
    end

    btn.MouseEnter:Connect(function()
        if not K.Waiting then Tween(btn, { BackgroundColor3 = lib.Theme.ElementHover }, 0.15) end
    end)
    btn.MouseLeave:Connect(function() Tween(btn, { BackgroundColor3 = lib.Theme.Element }, 0.2) end)
    btn.MouseButton1Click:Connect(function()
        K.Waiting = true
        refreshBtn()
    end)

    lib:Connect(UIS.InputBegan, function(input, processed)
        if K.Waiting then
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            K.Waiting = false
            if input.KeyCode == Enum.KeyCode.Escape then
                K:Set(nil)
            else
                K:Set(input.KeyCode)
            end
            return
        end
        if processed then return end
        if K.Key and input.KeyCode == K.Key then
            lib:SafeCall(K.Callback, K.Key, true)
        end
    end)

    if K.Show then lib:_RegisterKey(K) end
    K:Set(o.Default, true)
    lib.Setters[K.Flag] = function(v, s) K:Set(v, s) end

    return {
        Set = function(v, silent) K:Set(v, silent) end,
        Get = function() return K.Key end,
    }
end

