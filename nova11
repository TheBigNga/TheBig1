    }, track)
    Corner(5, knob)
    lib:Bind(knob, "BackgroundColor3", "Text")

    local hit = New("TextButton", {
        BackgroundTransparency = 1, Position = OFF(0, -9), Size = UD2(1, 0, 0, 21),
        Text = "", AutoButtonColor = false, ZIndex = 4,
    }, track)

    local sliding, hovering = false, false
    local function refreshKnob()
        local big = sliding or hovering
        Tween(knob, { Size = big and OFF(13, 13) or OFF(10, 10) }, 0.25, ES.Back)
        Tween(valueL, { TextColor3 = sliding and lib.Theme.Text or lib.Theme.SubText }, 0.2)
    end
    hit.MouseEnter:Connect(function() hovering = true refreshKnob() end)
    hit.MouseLeave:Connect(function() hovering = false refreshKnob() end)

    local function set(v, silent)
        v = Round(math.clamp(tonumber(v) or min, min, max), dec)
        S.Value = v
        local pct = (max == min) and 0 or (v - min) / (max - min)
        Tween(fill, { Size = UD2(pct, 0, 1, 0) }, 0.18)
        Tween(knob, { Position = UD2(pct, 0, 0.5, 0) }, 0.18)
        valueL.Text = string.format("%." .. dec .. "f", v) .. suffix
        if S.Flag then lib.Flags[S.Flag] = v end
        if not silent then lib:SafeCall(S.Callback, v) end
    end

    local function fromX(x)
        local p, w = track.AbsolutePosition.X, track.AbsoluteSize.X
        if w <= 0 then return end
        set(min + (max - min) * math.clamp((x - p) / w, 0, 1))
    end
    hit.InputBegan:Connect(function(i)
        if i.UserInputType == MB1 or i.UserInputType == TOUCH then
            sliding = true
            refreshKnob()
            fromX(i.Position.X)
        end
    end)
    lib:Connect(UIS.InputChanged, function(i)
        if sliding and (i.UserInputType == MOVE or i.UserInputType == TOUCH) then fromX(i.Position.X) end
    end)
    lib:Connect(UIS.InputEnded, function(i)
        if (i.UserInputType == MB1 or i.UserInputType == TOUCH) and sliding then
            sliding = false
            refreshKnob()
        end
    end)

    set(o.Default or min, true)
    if S.Flag then lib.Setters[S.Flag] = function(v, s) set(v, s) end end

    return {
        Set = function(v, silent) set(v, silent) end,
        Get = function() return S.Value end,
    }
end

---------------------------------------------------------------------
-- Dropdown (inline, single or multi)
---------------------------------------------------------------------
function SectionMT:Dropdown(o)
    o = o or {}
    local win = self.Window
    local lib = win.Library
    local D = {
        Flag = o.Flag or lib:NextFlag(),
        Multi = o.Multi and true or false,
        Callback = o.Callback or function() end,
        Value = nil,
        Options = {},
        Order = {},
        Open = false,
        Conn = nil,
    }
    D.Value = D.Multi and {} or nil

    self.Count = self.Count + 1
    local holder = New("Frame", {
        Size = UD2(1, 0, 0, 28), BackgroundTransparency = 1, LayoutOrder = self.Count,
    }, self.Body)

    local head = New("TextButton", {
        Size = UD2(1, 0, 1, 0), Text = "", AutoButtonColor = false,
    }, holder)
    Corner(6, head)
    lib:Bind(head, "BackgroundColor3", "Element")
    local headStroke = Stroke(head, "Stroke")

    local nameL = New("TextLabel", {
        BackgroundTransparency = 1, Position = OFF(10, 0), Size = UD2(0.45, -10, 1, 0),
        Text = tostring(o.Name or "select"), Font = FONT_TEXT, TextSize = 13,
        TextXAlignment = LEFT, TextTruncate = TRUNC,
    }, head)
    lib:Bind(nameL, "TextColor3", "Text")

    local valL = New("TextLabel", {
        BackgroundTransparency = 1, Position = UD2(0.45, 0, 0, 0), Size = UD2(0.55, -28, 1, 0),
        Text = "None", Font = FONT, TextSize = 10, TextXAlignment = RIGHT, TextTruncate = TRUNC,
    }, head)
    lib:Bind(valL, "TextColor3", "SubText")

    local chev = New("TextLabel", {
        AnchorPoint = V2(0.5, 0.5), Position = UD2(1, -14, 0.5, 0), Size = OFF(12, 12),
        BackgroundTransparency = 1, Text = "v", Font = FONT_BOLD, TextSize = 12,
    }, head)
    lib:Bind(chev, "TextColor3", "SubText")

    local popup = New("Frame", {
        Size = OFF(0, 0), Visible = false, ZIndex = 100, ClipsDescendants = true,
    }, lib.Holder)
    Corner(6, popup)
    lib:Bind(popup, "BackgroundColor3", "Surface")
    Stroke(popup, "Stroke")

    local list = New("ScrollingFrame", {
        Size = UD2(1, 0, 1, 0), BackgroundTransparency = 1, ZIndex = 101,
        ScrollBarThickness = 2, CanvasSize = UD2(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
    }, popup)
    lib:Bind(list, "ScrollBarImageColor3", "Stroke")
    Pad(list, 4, 4, 4, 4)
    VList(list, 2)

    local ITEM_H, MAX_H = 26, 196
    local alpha = New("NumberValue", { Value = 0 })

    local function isSel(n)
        if D.Multi then return table.find(D.Value, n) ~= nil end
        return D.Value == n
    end

    local function paint()
        if D.Multi then
            local n = #D.Value
            if n == 0 then valL.Text = "None"
            elseif n == 1 then valL.Text = D.Value[1]
            else valL.Text = n .. " selected" end
        else
            valL.Text = D.Value ~= nil and tostring(D.Value) or "None"
        end
        for n, it in pairs(D.Options) do
            local on = isSel(n)
            Tween(it.Label, {
                TextColor3 = on and lib.Theme.Text or lib.Theme.SubText,
                Position = on and OFF(12, 0) or OFF(8, 0),
            }, 0.2)
            Tween(it.Mark, {
                BackgroundTransparency = on and 0 or 1,
                Size = on and OFF(6, 6) or OFF(0, 0),
            }, on and 0.3 or 0.15, on and ES.Back or ES.Quint)
        end
    end

    local function place()
        local p, s = head.AbsolutePosition, head.AbsoluteSize
        local full = math.min(#D.Order * (ITEM_H + 2) + 8, MAX_H)
        popup.Position = OFF(p.X, p.Y + s.Y + 4)
        popup.Size = OFF(s.X, math.floor(full * alpha.Value + 0.5))
    end

    local function hide()
        popup.Visible = false
        alpha.Value = 0
        if D.Conn then D.Conn:Disconnect() D.Conn = nil end
    end

    local function close(instant)
        if not D.Open then return end
        D.Open = false
        Tween(chev, { Rotation = 0 }, 0.25)
        Tween(head, { BackgroundColor3 = lib.Theme.Element }, 0.2)
        Tween(headStroke, { Color = lib.Theme.Stroke }, 0.2)
        if instant then hide() return end
        local tw = Tween(alpha, { Value = 0 }, 0.2, ES.Quint, ED.In)
        tw.Completed:Connect(function()
            if not D.Open then hide() end
        end)
    end

    local function openIt()
        D.Open = true
        popup.Visible = true
        Tween(chev, { Rotation = 180 }, 0.35, ES.Back)
        Tween(head, { BackgroundColor3 = lib.Theme.ElementHover }, 0.15)
        Tween(headStroke, { Color = lib.Theme.Accent }, 0.2)
        Tween(alpha, { Value = 1 }, 0.35)
        if not D.Conn then
            D.Conn = RunService.Heartbeat:Connect(function()
                if not head.Parent or not win.Main.Visible then
                    close(true)
                    return
                end
                place()
            end)
        end
        place()
    end

    local function inside(f, p)
        local a, s = f.AbsolutePosition, f.AbsoluteSize
        return p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
    end

    lib:Connect(UIS.InputBegan, function(i)
        if not D.Open then return end
        if i.UserInputType ~= MB1 and i.UserInputType ~= TOUCH then return end
        if inside(popup, i.Position) or inside(head, i.Position) then return end
        close()
    end)

    head.MouseEnter:Connect(function()
        if not D.Open then Tween(head, { BackgroundColor3 = lib.Theme.ElementHover }, 0.15) end
    end)
    head.MouseLeave:Connect(function()
        if not D.Open then Tween(head, { BackgroundColor3 = lib.Theme.Element }, 0.2) end
    end)
    head.MouseButton1Click:Connect(function()
        if D.Open then close() else openIt() end
    end)

    local function setValue(v, silent)
        if D.Multi then
            D.Value = {}
            if type(v) == "table" then
                for _, x in ipairs(v) do
                    if D.Options[x] then table.insert(D.Value, x) end
                end
            end
        else
            if v ~= nil and not D.Options[v] then v = nil end
            D.Value = v
        end
        paint()
        local out = D.Multi and table.clone(D.Value) or D.Value
        lib.Flags[D.Flag] = out
        if not silent then lib:SafeCall(D.Callback, out) end
    end

    function D:Add(n)
        n = tostring(n)
        if D.Options[n] then return end
        local btn = New("TextButton", {
            Size = UD2(1, 0, 0, ITEM_H), BackgroundTransparency = 1, Text = "",
            AutoButtonColor = false, ZIndex = 102, LayoutOrder = #D.Order + 1,
        }, list)
        Corner(5, btn)
        lib:Bind(btn, "BackgroundColor3", "ElementHover")

        local label = New("TextLabel", {
            BackgroundTransparency = 1, Position = OFF(8, 0), Size = UD2(1, -26, 1, 0),
            Text = n, Font = FONT_TEXT, TextSize = 13, TextXAlignment = LEFT,
            TextTruncate = TRUNC, ZIndex = 103,
        }, btn)
        lib:Bind(label, "TextColor3", "SubText")
        local mark = New("Frame", {
            AnchorPoint = V2(1, 0.5), Position = UD2(1, -9, 0.5, 0), Size = OFF(0, 0),
            BackgroundTransparency = 1, ZIndex = 103,
        }, btn)
        Corner(3, mark)
        lib:Bind(mark, "BackgroundColor3", "Accent")

        btn.MouseEnter:Connect(function() Tween(btn, { BackgroundTransparency = 0.25 }, 0.12) end)
        btn.MouseLeave:Connect(function() Tween(btn, { BackgroundTransparency = 1 }, 0.2) end)
        btn.MouseButton1Click:Connect(function()
            if D.Multi then
                local idx = table.find(D.Value, n)
                if idx then table.remove(D.Value, idx) else table.insert(D.Value, n) end
                setValue(D.Value)
            else
                close()
                setValue(n)
            end
        end)

        D.Options[n] = { Button = btn, Label = label, Mark = mark }
        table.insert(D.Order, n)
        paint()
    end

    function D:Remove(n)
        n = tostring(n)
        local it = D.Options[n]
        if not it then return end
        it.Button:Destroy()
        D.Options[n] = nil
        local idx = table.find(D.Order, n)
        if idx then table.remove(D.Order, idx) end
        if D.Multi then
            local i = table.find(D.Value, n)
            if i then table.remove(D.Value, i) end
        elseif D.Value == n then
            D.Value = nil
        end
        paint()
    end

    function D:Refresh(items)
        local keep = D.Multi and table.clone(D.Value) or D.Value
        for _, n in ipairs(table.clone(D.Order)) do D:Remove(n) end
        for _, n in ipairs(items or {}) do D:Add(n) end
        setValue(keep, true)
    end

    for _, item in ipairs(o.Items or {}) do D:Add(item) end
    setValue(o.Default, true)
    lib.Setters[D.Flag] = function(v, s) setValue(v, s) end

    return {
        Set = function(v, silent) setValue(v, silent) end,
        Get = function() return D.Value end,
        Refresh = function(items) D:Refresh(items) end,
        Add = function(n) D:Add(n) end,
        Remove = function(n) D:Remove(n) end,
    }
end

