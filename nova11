-- Textbox
---------------------------------------------------------------------
function SectionMT:Textbox(o)
    o = o or {}
    local lib = self.Window.Library
    local T = {
        Flag = o.Flag or lib:NextFlag(),
        Callback = o.Callback or function() end,
        Value = tostring(o.Default or ""),
    }

    self.Count = self.Count + 1
    local holder = New("Frame", {
        Size = UD2(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, LayoutOrder = self.Count,
    }, self.Body)
    VList(holder, 5)

    if o.Name then
        local nameL = New("TextLabel", {
            Size = UD2(1, 0, 0, 14), BackgroundTransparency = 1, LayoutOrder = 0,
            Text = tostring(o.Name), Font = FONT_TEXT, TextSize = 13, TextXAlignment = LEFT,
        }, holder)
        lib:Bind(nameL, "TextColor3", "Text")
    end

    local box = New("TextBox", {
        Size = UD2(1, 0, 0, 28), LayoutOrder = 1, Text = T.Value,
        PlaceholderText = tostring(o.Placeholder or "enter text..."),
        ClearTextOnFocus = false, Font = FONT, TextSize = 11,
        TextXAlignment = LEFT, ClipsDescendants = true,
    }, holder)
    Corner(6, box)
    Pad(box, 0, 0, 10, 10)
    lib:Bind(box, { BackgroundColor3 = "Element", TextColor3 = "Text", PlaceholderColor3 = "SubText" })
    local st = Stroke(box, "Stroke")

    local function commit(v, silent)
        T.Value = tostring(v)
        lib.Flags[T.Flag] = T.Value
        if not silent then lib:SafeCall(T.Callback, T.Value) end
    end

    local focused = false
    box.MouseEnter:Connect(function()
        if not focused then Tween(box, { BackgroundColor3 = lib.Theme.ElementHover }, 0.15) end
    end)
    box.MouseLeave:Connect(function()
        if not focused then Tween(box, { BackgroundColor3 = lib.Theme.Element }, 0.2) end
    end)
    box.Focused:Connect(function()
        focused = true
        Tween(st, { Color = lib.Theme.Accent, Thickness = 1.25 }, 0.2)
        Tween(box, { BackgroundColor3 = lib.Theme.ElementHover }, 0.15)
    end)
    box.FocusLost:Connect(function()
        focused = false
        Tween(st, { Color = lib.Theme.Stroke, Thickness = 1 }, 0.25)
        Tween(box, { BackgroundColor3 = lib.Theme.Element }, 0.2)
        commit(box.Text)
    end)

    commit(T.Value, true)
    lib.Setters[T.Flag] = function(v, s)
        box.Text = tostring(v)
        commit(v, s)
    end

    return {
        Set = function(v, silent) box.Text = tostring(v) commit(v, silent) end,
        Get = function() return T.Value end,
    }
end

