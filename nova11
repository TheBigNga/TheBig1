---------------------------------------------------------------------
-- Theme binding
---------------------------------------------------------------------
local function Resolve(src)
    if type(src) == "function" then return src() end
    return Library.Theme[src]
end

function Library:Bind(obj, a, b)
    local props = type(a) == "table" and a or { [a] = b }
    self.Bindings[obj] = self.Bindings[obj] or {}
    for p, src in pairs(props) do
        self.Bindings[obj][p] = src
        obj[p] = Resolve(src)
        if p == "BackgroundColor3" and (src == "Element" or src == "Section" or src == "SectionHead") then
            self.Glass[obj] = true
            obj.BackgroundTransparency = self.WindowTransparency
        end
    end
    return obj
end

function Library:SetThemeColor(key, color)
    self.Theme[key] = color
    for obj, props in pairs(self.Bindings) do
        for prop, src in pairs(props) do
            if src == key or type(src) == "function" then
                pcall(function() obj[prop] = Resolve(src) end)
            end
        end
    end
end

function Library:SetAccent(c1, c2)
    self:SetThemeColor("Accent", c1)
    self:SetThemeColor("Accent2", c2 or c1)
end

-- Library:SetStatus("Away", Color3.fromRGB(226, 186, 110))
function Library:SetStatus(text, color)
    local s = self.StatusRefs
    if not s then return end
    if text then s.Label.Text = tostring(text) end
    if color then s.Dot.BackgroundColor3 = color end
end

---------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------
local function New(class, props, parent)
    local inst = Instance.new(class)
    if inst:IsA("GuiObject") then inst.BorderSizePixel = 0 end
    if props then
        for k, v in pairs(props) do inst[k] = v end
    end
    if parent then inst.Parent = parent end
    return inst
end

local function Corner(r, parent)
    return New("UICorner", { CornerRadius = UD(0, r or 6) }, parent)
end

local function Pad(parent, t, b, l, r)
    return New("UIPadding", {
        PaddingTop = UD(0, t or 0), PaddingBottom = UD(0, b or 0),
        PaddingLeft = UD(0, l or 0), PaddingRight = UD(0, r or 0),
    }, parent)
end

local function VList(parent, pad)
    return New("UIListLayout", { Padding = UD(0, pad or 0), SortOrder = Enum.SortOrder.LayoutOrder }, parent)
end

local function Stroke(parent, key, thick, transp)
    local s = New("UIStroke", {
        Thickness = thick or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Transparency = transp or 0,
    }, parent)
    Library:Bind(s, "Color", key or "Stroke")
    return s
end

local function OnAccent()
    local a = Library.Theme.Accent
    local l = 0.299 * a.R + 0.587 * a.G + 0.114 * a.B
    return l > 0.6 and Color3.fromRGB(18, 18, 20) or WHITE
end

local function Tween(o, props, t, style, dir)
    local tw = TweenService:Create(o, TweenInfo.new(t or 0.18, style or ES.Quint, dir or ED.Out), props)
    tw:Play()
    return tw
end

local function Round(n, dec)
    local m = 10 ^ (dec or 0)
    return math.floor(n * m + 0.5) / m
end

local function NextRow(sec, h, kind)
    sec.Count = sec.Count + 1
    local props = { Size = UD2(1, 0, 0, h or 20), BackgroundTransparency = 1, LayoutOrder = sec.Count }
    if kind == "button" then
        props.Text = ""
        props.AutoButtonColor = false
        return New("TextButton", props, sec.Body)
    end
    return New("Frame", props, sec.Body)
end

function Library:Connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(self.Connections, c)
    return c
end

function Library:SafeCall(fn, ...)
    if type(fn) ~= "function" then return end
    local ok, err = pcall(fn, ...)
    if not ok then warn("[Lib Fac!] " .. tostring(err)) end
end

function Library:NextFlag()
    self.FlagCount = self.FlagCount + 1
    return "flag_" .. self.FlagCount
end

local function Draggable(lib, handle, obj)
    local dragging, dStart, sPos, target = false, nil, nil, nil
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == MB1 or i.UserInputType == TOUCH then
            dragging, dStart, sPos, target = true, i.Position, obj.Position, obj.Position
        end
    end)
    lib:Connect(UIS.InputChanged, function(i)
        if dragging and (i.UserInputType == MOVE or i.UserInputType == TOUCH) then
            local d = i.Position - dStart
            target = UD2(sPos.X.Scale, sPos.X.Offset + d.X, sPos.Y.Scale, sPos.Y.Offset + d.Y)
        end
    end)
    lib:Connect(UIS.InputEnded, function(i)
        if i.UserInputType == MB1 or i.UserInputType == TOUCH then dragging = false end
    end)
    lib:Connect(RunService.Heartbeat, function(dt)
        if not target then return end
        local nxt = obj.Position:Lerp(target, 1 - math.exp(-dt * 26))
        if not dragging
            and math.abs(nxt.X.Offset - target.X.Offset) < 0.5
            and math.abs(nxt.Y.Offset - target.Y.Offset) < 0.5 then
            nxt = target
            target = nil
        end
        obj.Position = nxt
    end)
end

---------------------------------------------------------------------
-- Blur / visibility / appearance
---------------------------------------------------------------------
function Library:GetBlur()
    if self.Blur and self.Blur.Parent then return self.Blur end
    local ok, b = pcall(function()
        local e = Instance.new("BlurEffect")
        e.Size = 0
        e.Parent = game:GetService("Lighting")
        return e
    end)
    self.Blur = ok and b or nil
    return self.Blur
end

function Library:UpdateBlur(open, t)
    local b = self:GetBlur()
    if b then
        Tween(b, { Size = (open and self.BlurEnabled) and self.BlurSize or 0 }, t or 0.35, ES.Quad)
    end
end

function Library:SetBlur(on, size)
    if on ~= nil then self.BlurEnabled = on and true or false end
    if size then self.BlurSize = math.clamp(size, 0, 56) end
    self:UpdateBlur(self.Window and self.Window.Open, 0.25)
end

function Library:_ApplyAppearance()
    local t = self.Flags.ui_transparency
    if type(t) == "number" then
        self.WindowTransparency = math.clamp(t / 100, 0, 0.9)
    end
    local b = self.Flags.ui_blur
    if type(b) == "boolean" then self.BlurEnabled = b end
    if self.Window and self.Window.Main then
        self.Window.Main.BackgroundTransparency = self.WindowTransparency
    end
    for obj in pairs(self.Glass) do
        if obj.Parent and not obj:GetAttribute("NoGlass") then
            obj.BackgroundTransparency = self.WindowTransparency
        end
    end
    self:UpdateBlur(self.Window and self.Window.Open, 0.25)
end

function Library:SetTransparency(p)
    local v = math.clamp(tonumber(p) or 0, 0, 0.9)
    self.Flags.ui_transparency = math.floor(v * 100 + 0.5)
    self:_ApplyAppearance()
end

function Library:GetTransparency()
    return self.WindowTransparency
end

function Library:SetVisible(v)
    self.Visible = v and true or false
    if self.Window then self.Window:SetOpen(self.Visible) end
end

