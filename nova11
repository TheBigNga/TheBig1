---------------------------------------------------------------------
function SectionMT:Toggle(o)
    o = o or {}
    local lib = self.Window.Library
    local T = {
        Flag = o.Flag or lib:NextFlag(),
        Callback = o.Callback or function() end,
        Value = false,
    }

    local row = NextRow(self, 18, "button")

    local label = New("TextLabel", {
        BackgroundTransparency = 1, Size = UD2(1, -26, 1, 0), Text = tostring(o.Name or "toggle"),
        Font = FONT_TEXT, TextSize = 13, TextXAlignment = LEFT, TextTruncate = TRUNC,
    }, row)
    lib:Bind(label, "TextColor3", "SubText")

    local box = New("Frame", {
        AnchorPoint = V2(1, 0.5), Position = UD2(1, 0, 0.5, 0), Size = OFF(14, 14),
    }, row)
    Corner(4, box)
    lib:Bind(box, "BackgroundColor3", "Element")
    local boxStroke = Stroke(box, "Stroke")

    local fill = New("Frame", {
        AnchorPoint = V2(0.5, 0.5), Position = UD2(0.5, 0, 0.5, 0), Size = OFF(0, 0),
        BackgroundTransparency = 1,
    }, box)
    Corner(3, fill)
    lib:Bind(fill, "BackgroundColor3", "Accent")

    function T:Set(v, silent)
        T.Value = v and true or false
        lib.Flags[T.Flag] = T.Value
        local on = T.Value
        Tween(fill, {
            BackgroundTransparency = on and 0 or 1,
            Size = on and OFF(8, 8) or OFF(0, 0),
        }, on and 0.35 or 0.2, on and ES.Back or ES.Quint)
        Tween(boxStroke, { Color = on and lib.Theme.Accent or lib.Theme.Stroke }, 0.2)
        Tween(label, { TextColor3 = on and lib.Theme.Text or lib.Theme.SubText }, 0.2)
        if not silent then lib:SafeCall(T.Callback, on) end
    end

    local function restBox() Tween(box, { Size = OFF(14, 14) }, 0.3, ES.Back) end
    row.MouseEnter:Connect(function()
        if not T.Value then Tween(label, { TextColor3 = lib.Theme.Text }, 0.15) end
    end)
    row.MouseLeave:Connect(function()
        if not T.Value then Tween(label, { TextColor3 = lib.Theme.SubText }, 0.2) end
        restBox()
    end)
    row.MouseButton1Down:Connect(function() Tween(box, { Size = OFF(11, 11) }, 0.08) end)
    row.MouseButton1Up:Connect(restBox)
    row.MouseButton1Click:Connect(function() T:Set(not T.Value) end)

    T:Set(o.Default == true, true)
    lib.Setters[T.Flag] = function(v, s) T:Set(v, s) end

    return {
        Set = function(v, silent) T:Set(v, silent) end,
        Get = function() return T.Value end,
    }
end

