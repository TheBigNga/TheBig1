        ScrollingDirection = Enum.ScrollingDirection.Y, ZIndex = 2,
    }, main)
    Pad(side, 12, 12, 10, 10)
    VList(side, 4)

    -- footer: green dot + "Online", bottom-left
    local foot = New("Frame", {
        Position = UD2(0, 0, 1, -FOOT_H), Size = UD2(0, SIDE_W, 0, FOOT_H),
        BackgroundTransparency = 1, ZIndex = 3,
    }, main)
    local footLine = New("Frame", { Size = UD2(0, SIDE_W, 0, 1), ZIndex = 3 }, foot)
    self:Bind(footLine, "BackgroundColor3", "Stroke")
    local statusDot = New("Frame", {
        AnchorPoint = V2(0, 0.5), Position = UD2(0, 16, 0.5, 0), Size = OFF(8, 8), ZIndex = 4,
        BackgroundColor3 = ONLINE_COLOR,
    }, foot)
    Corner(4, statusDot)
    local statusLbl = New("TextLabel", {
        BackgroundTransparency = 1, AnchorPoint = V2(0, 0.5), Position = UD2(0, 32, 0.5, 0),
        Size = UD2(1, -40, 0, 16), Text = tostring(opts.Status or "Online"), Font = FONT_TEXT, TextSize = 13,
        TextXAlignment = LEFT, ZIndex = 4,
    }, foot)
    self:Bind(statusLbl, "TextColor3", "SubText")
    self.StatusRefs = { Dot = statusDot, Label = statusLbl }

    local vDivider = New("Frame", { Position = OFF(SIDE_W, 45), Size = UD2(0, 1, 1, -45), ZIndex = 3 }, main)
    self:Bind(vDivider, "BackgroundColor3", "Stroke")

    -- content
    local content = New("Frame", {
        Position = OFF(SIDE_W + 1, 45), Size = UD2(1, -(SIDE_W + 1), 1, -45),
        BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 2,
    }, main)

    local win = setmetatable({
        Library = self, Name = name, Version = version,
        Main = main, Side = side, Content = content,
        Groups = {}, Subs = {}, Open = false,
    }, WindowMT)
    self.Window = win

    Draggable(self, header, main)

    function win:SetOpen(open)
        self.Open = open
        lib.Visible = open
        if open then
            main.Visible = true
            Tween(main, { GroupTransparency = 0 }, 0.3, ES.Quad)
            Tween(mainScale, { Scale = 1 }, 0.5, ES.Back)
        else
            Tween(main, { GroupTransparency = 1 }, 0.2, ES.Quad, ED.In)
            Tween(mainScale, { Scale = 0.95 }, 0.2, ES.Quad, ED.In)
            task.delay(0.21, function()
                if not win.Open then main.Visible = false end
            end)
        end
        lib:UpdateBlur(open)
    end

    self:Connect(UIS.InputBegan, function(input, processed)
        if processed then return end
        local tk = lib.Flags.menu_toggle
        if tk and input.KeyCode.Name == tk then lib:SetVisible(not lib.Visible) end
    end)

    -- mobile toggle button
    if UIS.TouchEnabled and not UIS.KeyboardEnabled then
        local tb = New("TextButton", {
            Position = OFF(12, 12), Size = OFF(36, 36), Text = string.upper(string.sub(name, 1, 1)),
            Font = FONT_BOLD, TextSize = 16, AutoButtonColor = false, ZIndex = 60,
        }, gui)
        Corner(8, tb)
        self:Bind(tb, { BackgroundColor3 = "Surface", TextColor3 = "Accent" })
        Stroke(tb, "Stroke", 1, 0.2)
        local tbScale = New("UIScale", { Scale = 1 }, tb)
        tb.MouseButton1Down:Connect(function() Tween(tbScale, { Scale = 0.88 }, 0.08) end)
        tb.MouseButton1Up:Connect(function() Tween(tbScale, { Scale = 1 }, 0.35, ES.Back) end)
        tb.MouseButton1Click:Connect(function() lib:SetVisible(not lib.Visible) end)
    end

    -- loader
    local loadTime = opts.LoadTime or 1.0
    local loader = New("CanvasGroup", { Size = UD2(1, 0, 1, 0), GroupTransparency = 0, ZIndex = 50 }, main)
    self:Bind(loader, "BackgroundColor3", "Background")

    local lTitle = New("TextLabel", {
        AnchorPoint = V2(0.5, 0.5), Position = UD2(0.5, 0, 0.5, -12), Size = OFF(260, 20),
        BackgroundTransparency = 1, Text = string.lower(name), Font = FONT_BOLD, TextSize = 15,
        TextTransparency = 1,
    }, loader)
    self:Bind(lTitle, "TextColor3", "Text")

    local track = New("Frame", {
        AnchorPoint = V2(0.5, 0.5), Position = UD2(0.5, 0, 0.5, 14), Size = OFF(180, 2),
    }, loader)
    Corner(1, track)
    self:Bind(track, "BackgroundColor3", "Stroke")
    local fill = New("Frame", { Size = UD2(0, 0, 1, 0) }, track)
    Corner(1, fill)
    self:Bind(fill, "BackgroundColor3", "Accent")

    local status = New("TextLabel", {
        AnchorPoint = V2(0.5, 0.5), Position = UD2(0.5, 0, 0.5, 30), Size = OFF(260, 14),
        BackgroundTransparency = 1, Text = "loading", Font = FONT, TextSize = 10,
        TextTransparency = 1,
    }, loader)
    self:Bind(status, "TextColor3", "SubText")

    Tween(lTitle, { TextTransparency = 0, Position = UD2(0.5, 0, 0.5, -16) }, 0.5)
    Tween(status, { TextTransparency = 0 }, 0.5)
    Tween(fill, { Size = UD2(1, 0, 1, 0) }, loadTime, ES.Quart, ED.InOut)
    task.spawn(function()
        task.wait(loadTime + 0.1)
        status.Text = "ready"
        task.wait(0.25)
        Tween(loader, { GroupTransparency = 1 }, 0.4, ES.Quad)
        task.wait(0.45)
        if loader.Parent then loader:Destroy() end
    end)

    task.defer(function() win:SetOpen(true) end)
    return win
end

