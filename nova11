-- Watermark
---------------------------------------------------------------------
function Library:Watermark(o)
    o = o or {}
    local lib = self
    local W = {
        Text = tostring(o.Text or o.Name or "nova"),
        ShowFPS = o.FPS ~= false,
        ShowPing = o.Ping ~= false,
        ShowTime = o.Time ~= false,
    }

    local frame = New("Frame", {
        AnchorPoint = V2(1, 0), Position = UD2(1, -12, 0, -30), Size = UD2(0, 0, 0, 24),
        AutomaticSize = Enum.AutomaticSize.X, ZIndex = 90,
    }, lib.Holder)
    Corner(6, frame)
    lib:Bind(frame, "BackgroundColor3", "Surface")
    Stroke(frame, "Stroke", 1, 0.2)
    Pad(frame, 0, 0, 10, 10)

    local label = New("TextLabel", {
        BackgroundTransparency = 1, Size = UD2(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
        Font = FONT, TextSize = 10, ZIndex = 91,
    }, frame)
    lib:Bind(label, "TextColor3", "Text")

    Tween(frame, { Position = UD2(1, -12, 0, 12) }, 0.6, ES.Back)

    local fps, ping = 60, 0
    local frames, acc = 0, 0

    local function render()
        local parts = { W.Text }
        if W.ShowFPS then parts[#parts + 1] = math.floor(fps + 0.5) .. " fps" end
        if W.ShowPing then parts[#parts + 1] = ping .. " ms" end
        if W.ShowTime then parts[#parts + 1] = os.date("%H:%M:%S") end
        label.Text = table.concat(parts, "  ·  ")
    end

    local conn = lib:Connect(RunService.Heartbeat, function(dt)
        frames = frames + 1
        acc = acc + dt
        if acc >= 0.5 then
            fps = frames / acc
            frames, acc = 0, 0
            local ok, v = pcall(function()
                return math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue())
            end)
            ping = ok and v or 0
            render()
        end
    end)
    render()

    function W:SetText(t)
        W.Text = tostring(t)
        render()
    end
    function W:SetVisible(v)
        frame.Visible = v and true or false
    end
    function W:Destroy()
        if conn then conn:Disconnect() end
        frame:Destroy()
    end
    W.Frame = frame
    return W
end

---------------------------------------------------------------------
-- Settings (save / load flags as json)
---------------------------------------------------------------------
local function SettingsDir(lib)
    return lib.Folder .. "/Settings"
end

function Library:GetFlagsTable()
    local out = {}
    for k, v in pairs(self.Flags) do
        if typeof(v) == "Color3" then v = v:ToHex() end
        if typeof(v) == "EnumItem" then v = v.Name end
        if type(v) == "table" or type(v) == "string" or type(v) == "number" or type(v) == "boolean" then
            out[k] = v
        end
    end
    return out
end

function Library:GetSettings()
    local ok, json = pcall(HttpService.JSONEncode, HttpService, self:GetFlagsTable())
    return ok and json or "{}"
end

function Library:ApplySettings(json)
    local ok, data = pcall(HttpService.JSONDecode, HttpService, json)
    if not ok or type(data) ~= "table" then return false end
    for flag, value in pairs(data) do
        local set = self.Setters[flag]
        if set then pcall(set, value, true) end
    end
    self:_ApplyAppearance()
    return true
end

function Library:SaveSetting(name, description)
    if not HasFS or not name or name == "" then return false end
    if not isfolder(self.Folder) then makefolder(self.Folder) end
    local dir = SettingsDir(self)
    if not isfolder(dir) then makefolder(dir) end
    local ok, json = pcall(HttpService.JSONEncode, HttpService, {
        meta = { name = name, description = description or "", saved = os.time() },
        flags = self:GetFlagsTable(),
    })
    if not ok then return false end
    writefile(dir .. "/" .. name .. ".json", json)
    return true
end

function Library:LoadSetting(name)
    if not HasFS or not name or name == "" then return false end
    local path = SettingsDir(self) .. "/" .. name .. ".json"
    if not isfile(path) then return false end
    local raw = readfile(path)
    local ok, data = pcall(HttpService.JSONDecode, HttpService, raw)
    if not ok or type(data) ~= "table" then return false end
    return self:ApplySettings(HttpService:JSONEncode(data.flags or data))
end

function Library:DeleteSetting(name)
    if not HasFS or typeof(delfile) ~= "function" or not name then return false end
    local path = SettingsDir(self) .. "/" .. name .. ".json"
    if not isfile(path) then return false end
    delfile(path)
    return true
end

function Library:ListSettings()
    local out = {}
    if not HasFS then return out end
    local dir = SettingsDir(self)
    if not isfolder(dir) then return out end
    for _, path in ipairs(listfiles(dir)) do
        local name = tostring(path):match("([^/\\]+)%.json$")
        if name then table.insert(out, name) end
    end
    table.sort(out)
    return out
end

Library.GetConfig = Library.GetSettings
Library.LoadConfig = Library.ApplySettings
Library.SaveConfig = Library.SaveSetting
Library.LoadConfigFile = Library.LoadSetting
Library.ListConfigs = Library.ListSettings

function Library:SettingsTab(win)
    local lib = self
    local tab = win:Tab({ Name = "Settings" })
    local sub = tab:SubTab({ Name = "Manage" })

    local menuSec = sub:Section({ Name = "Menu" })
    menuSec:Keybind({ Name = "Toggle key", Flag = "menu_toggle", Default = lib.ToggleKey })
    menuSec:Toggle({
        Name = "Show keybind list", Flag = "show_keylist", Default = false,
        Callback = function() lib:_RefreshKeyVisibility() end,
    })

    local lookSec = sub:Section({ Name = "Appearance" })
    local trBox, trSlider
    trSlider = lookSec:Slider({
        Name = "Window Transparency",
        Flag = "ui_transparency",
        Min = 0,
        Max = 90,
        Default = math.floor(lib.WindowTransparency * 100 + 0.5),
        Decimals = 0,
        Suffix = "%",
        Callback = function(v)
            lib:_ApplyAppearance()
            if trBox then trBox.Set(v, true) end
        end,
    })
    trBox = lookSec:Textbox({
        Name = "Type percent (0 - 90)",
        Flag = "ui_transparency_text",
        Default = tostring(math.floor(lib.WindowTransparency * 100 + 0.5)),
        Placeholder = "25",
        Callback = function(text)
            local n = tonumber(text)
            if n then trSlider.Set(math.clamp(n, 0, 90)) end
        end,
    })
    lookSec:Toggle({
        Name = "Background Blur",
        Flag = "ui_blur",
        Default = lib.BlurEnabled,
        Callback = function(on)
            lib:SetBlur(on)
        end,
    })

    local saveSec = sub:Section({ Name = "Save" })
    local nameBox = saveSec:Textbox({ Name = "Name", Placeholder = "my setting" })

    local loadSec = sub:Section({ Name = "Load", Side = 2 })
    local list = loadSec:Dropdown({ Name = "Setting", Items = self:ListSettings() })

    saveSec:Button({
        Name = "Save",
        Callback = function()
            local n = nameBox.Get()
            if n == "" then
                lib:Notify({ Title = "Settings", Text = "Enter a name first.", Type = "warning" })
                return
            end
            local ok = lib:SaveSetting(n)
            lib:Notify({
                Title = "Settings",
                Text = ok and ('Saved "' .. n .. '".') or "Could not save.",
                Type = ok and "success" or "error",
            })
            list.Refresh(lib:ListSettings())
        end,
    })

    loadSec:Button({
        Name = "Load",
        Callback = function()
            local n = list.Get()
            if not n then
                lib:Notify({ Title = "Settings", Text = "Pick a setting first.", Type = "warning" })
                return
            end
            local ok = lib:LoadSetting(n)
            lib:Notify({
                Title = "Settings",
                Text = ok and ('Loaded "' .. n .. '".') or "Could not load.",
                Type = ok and "success" or "error",
            })
        end,
    })

    loadSec:Button({
        Name = "Delete",
        Callback = function()
            local n = list.Get()
            if not n then
                lib:Notify({ Title = "Settings", Text = "Pick a setting first.", Type = "warning" })
                return
            end
            local ok = lib:DeleteSetting(n)
            list.Refresh(lib:ListSettings())
            lib:Notify({
                Title = "Settings",
                Text = ok and ('Deleted "' .. n .. '".') or "Could not delete.",
                Type = ok and "info" or "error",
            })
        end,
    })

    loadSec:Button({
        Name = "Refresh list",
        Callback = function() list.Refresh(lib:ListSettings()) end,
    })

    local unloadSec = sub:Section({ Name = "Unload" })
    unloadSec:Label("Closes the menu and removes the script completely.")
    unloadSec:Button({
        Name = "Unload",
        Callback = function()
            lib:Notify({ Title = "Lib Fac!", Text = "Unloading...", Type = "info", Duration = 1 })
            task.delay(0.6, function() lib:Unload() end)
        end,
    })

    return tab
end

---------------------------------------------------------------------
-- Unload
---------------------------------------------------------------------
function Library:Unload()
    for _, c in ipairs(self.Connections) do
        pcall(function() c:Disconnect() end)
    end
    self.Connections = {}
    if self.Blur then pcall(function() self.Blur:Destroy() end) self.Blur = nil end
    if self.Holder then pcall(function() self.Holder:Destroy() end) end
    if genv.LibFac == self then genv.LibFac = nil end
end

genv.LibFac = Library
return Library
