local function LoadThumb(img, userId)
    task.spawn(function()
        local ok, content = pcall(Players.GetUserThumbnailAsync, Players, userId,
            Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
        if ok and img.Parent and content then img.Image = content end
    end)
end

-- Library:SetProfile({ Name = "Name", Handle = "handle", Image = "rbxassetid://...", UserId = 123 })
function Library:SetProfile(p)
    p = p or {}
    local r = self.ProfileRefs
    if not r then return end
    if p.Name then r.Name.Text = tostring(p.Name) end
    if p.Handle then r.Handle.Text = "@" .. (tostring(p.Handle):gsub("^@", "")) end
    if p.Image then
        r.Avatar.Image = tostring(p.Image)
    elseif p.UserId then
        LoadThumb(r.Avatar, p.UserId)
    end
end

