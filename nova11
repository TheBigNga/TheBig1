---------------------------------------------------------------------
-- Search: finds main tabs, sub tabs and sections by name
---------------------------------------------------------------------
local KIND_RANK = { group = 3, sub = 2, section = 1 }

-- returns the best match: { kind = "group" | "sub" | "section", data = ..., exact = bool }
function WindowMT:Find(query)
    local q = string.lower(string.match(query or "", "^%s*(.-)%s*$") or "")
    if q == "" then return nil end
    local best, bestRank = nil, -1

    local function consider(kind, name, data)
        local n = string.lower(name or "")
        local score
        if n == q then score = 3
        elseif string.sub(n, 1, #q) == q then score = 2
        elseif string.find(n, q, 1, true) then score = 1
        else return end
        local rank = score * 10 + KIND_RANK[kind]
        if rank > bestRank then
            best, bestRank = { kind = kind, data = data, exact = score == 3 }, rank
        end
    end

    for _, g in ipairs(self.Groups) do consider("group", g.Name, g) end
    for _, s in ipairs(self.Subs) do consider("sub", s.Name, s) end
    for _, s in ipairs(self.Subs) do
        for _, sec in ipairs(s.Sections) do consider("section", sec.Name, sec) end
    end
    return best
end

-- opens the main tab, sub tab or section that Find returned
function WindowMT:Navigate(hit)
    if not hit then return end
    if hit.kind == "group" then
        self:SelectGroup(hit.data)
    elseif hit.kind == "sub" then
        self:SelectGroup(hit.data.Group)
        self:SelectSub(hit.data)
    else
        local sec = hit.data
        self:SelectGroup(sec.Sub.Group)
        self:SelectSub(sec.Sub)
        self:RevealSection(sec)
    end
end

-- scrolls the section into view, then flashes it for a moment
function WindowMT:RevealSection(sec)
    task.spawn(function()
        task.wait() -- let the layout update after the page opens
        if not sec.Card.Parent then return end
        local col = sec.Column
        col.CanvasPosition = Vector2.new(0, math.max(0,
            col.CanvasPosition.Y + (sec.Card.AbsolutePosition.Y - col.AbsolutePosition.Y) - 8))
    end)
end


function WindowMT:SelectGroup(g)
    local lib = self.Library
    self.CurrentGroup = g
    for _, o in ipairs(self.Groups) do
        local on = o == g
        local was = o.Selected
        o.Selected = on
        o.SubList.Visible = on
        Tween(o.Label, { TextColor3 = on and lib.Theme.Text or lib.Theme.SubText }, 0.25)
        Tween(o.Bar, {
            BackgroundTransparency = on and 0 or 1,
            Size = on and OFF(3, 16) or OFF(3, 4),
        }, on and 0.4 or 0.2, on and ES.Back or ES.Quint)
        Tween(o.Button, {
            BackgroundColor3 = on and lib.Theme.SectionHead or lib.Theme.Element,
            BackgroundTransparency = on and 0 or 1,
        }, 0.2)

        if on and not was then
            for i, sub in ipairs(o.Subs) do
                sub.Label.TextTransparency = 1
                task.delay(0.04 * (i - 1), function()
                    if o.Selected and sub.Label.Parent then
                        Tween(sub.Label, { TextTransparency = 0 }, 0.3)
                    end
                end)
            end
        end
    end
    if g.Active then self:SelectSub(g.Active) end
end

function WindowMT:Tab(o)
