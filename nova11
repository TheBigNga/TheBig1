function WindowMT:SelectSub(s)
    local lib = self.Library
    self.CurrentSub = s
    s.Group.Active = s
    for _, o in ipairs(self.Subs) do
        local on = o == s
        o.Active = on
        if not on then o.Page.Visible = false end
        Tween(o.Label, {
            TextColor3 = on and lib.Theme.Text or lib.Theme.SubText,
            Position = on and OFF(18, 0) or OFF(14, 0),
        }, 0.25)
        Tween(o.Button, {
            BackgroundTransparency = on and 0 or 1,
            BackgroundColor3 = on and lib.Theme.ElementHover or lib.Theme.Element,
        }, 0.2)
        Tween(o.Bar, {
            BackgroundTransparency = on and 0 or 1,
            Size = on and OFF(3, 14) or OFF(3, 4),
        }, on and 0.4 or 0.2, on and ES.Back or ES.Quint)
    end

    local page = s.Page
    if not page.Visible then
        page.Visible = true
        page.GroupTransparency = 1
        page.Position = OFF(0, 8)
        Tween(page, { GroupTransparency = 0, Position = OFF(0, 0) }, 0.35)

        s.Token = (s.Token or 0) + 1
        local tok = s.Token
        for i, col in ipairs(s.Columns) do
            local base = s.ColBase[i]
            col.Position = base + OFF(0, 18)
            task.delay((i - 1) * 0.06, function()
                if s.Token == tok and col.Parent then
                    Tween(col, { Position = base }, 0.5)
                end
            end)
        end
    end
end

