function Library:_EnsureKeyList()
    if self.KeyList then return self.KeyList end

    local panel = New("Frame", {
        Name = "KeyList", Position = OFF(12, 120), Size = OFF(200, 0),
        AutomaticSize = Enum.AutomaticSize.Y, Visible = false, ZIndex = 80,
    }, self.Holder)
    Corner(8, panel)
    self:Bind(panel, "BackgroundColor3", "Surface")
    Stroke(panel, "Stroke", 1, 0.2)
    VList(panel, 0)

    local head = New("Frame", {
        Size = UD2(1, 0, 0, 30), BackgroundTransparency = 1, LayoutOrder = 0, ZIndex = 81,
    }, panel)
    local titleL = New("TextLabel", {
        BackgroundTransparency = 1, Position = OFF(12, 0), Size = UD2(1, -24, 1, 0),
        Text = "KEYBINDS", Font = FONT_BOLD, TextSize = 10, TextXAlignment = LEFT, ZIndex = 82,
    }, head)
    self:Bind(titleL, "TextColor3", "SubText")

    local div = New("Frame", { Size = UD2(1, 0, 0, 1), LayoutOrder = 1, ZIndex = 81 }, panel)
    self:Bind(div, "BackgroundColor3", "Stroke")

    local rows = New("Frame", {
        Size = UD2(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, LayoutOrder = 2, ZIndex = 81,
    }, panel)
    Pad(rows, 8, 10, 12, 12)
    VList(rows, 6)

    Draggable(self, head, panel)

    self.KeyList = { Panel = panel, Rows = rows }

    local acc = 0
    self:Connect(RunService.Heartbeat, function(dt)
        acc = acc + dt
        if acc >= 0.15 then
            acc = 0
            self:_RefreshKeyValues()
        end
    end)
    return self.KeyList
end

function Library:_BuildKeyRow(K)
    local list = self:_EnsureKeyList()
    local row = New("Frame", {
        Size = UD2(1, 0, 0, 18), BackgroundTransparency = 1, Visible = false, ZIndex = 82,
    }, list.Rows)
    New("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal, Padding = UD(0, 6),
        VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder,
    }, row)

    local chip = New("Frame", {
        Size = UD2(0, 0, 0, 16), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = 1, ZIndex = 82,
    }, row)
    Corner(4, chip)
    self:Bind(chip, "BackgroundColor3", "Element")
    Pad(chip, 0, 0, 6, 6)

    local chipT = New("TextLabel", {
        BackgroundTransparency = 1, Size = UD2(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
        Font = FONT_BOLD, TextSize = 10, ZIndex = 83,
    }, chip)
    self:Bind(chipT, "TextColor3", "Accent")

    local nameL = New("TextLabel", {
        BackgroundTransparency = 1, Size = UD2(0, 0, 0, 18), AutomaticSize = Enum.AutomaticSize.X,
        LayoutOrder = 2, Text = K.Name, Font = FONT_TEXT, TextSize = 13, ZIndex = 82,
    }, row)
    self:Bind(nameL, "TextColor3", "Text")

    local valL = New("TextLabel", {
        BackgroundTransparency = 1, Size = UD2(0, 0, 0, 18), AutomaticSize = Enum.AutomaticSize.X,
        LayoutOrder = 3, Text = "", Font = FONT, TextSize = 10, ZIndex = 82,
    }, row)
    self:Bind(valL, "TextColor3", "SubText")

    K.Row = { Frame = row, Chip = chipT, Value = valL, Name = nameL, Shown = false }
    return K.Row
end

function Library:_RegisterKey(K)
    self.KeyEntries = self.KeyEntries or {}
    table.insert(self.KeyEntries, K)
    self:_BuildKeyRow(K)
    self:_UpdateKeyRow(K)
end

function Library:_UpdateKeyRow(K)
    local r = K.Row
    if not r then return end
    local show = K.Key ~= nil
    r.Frame.Visible = show
    r.Chip.Text = K.Key and K.Key.Name or ""
    if show and not r.Shown then
        r.Chip.TextTransparency = 1
        r.Name.TextTransparency = 1
        Tween(r.Chip, { TextTransparency = 0 }, 0.35)
        Tween(r.Name, { TextTransparency = 0 }, 0.35)
    end
    r.Shown = show
    self:_RefreshKeyVisibility()
end

function Library:_RefreshKeyValues()
    for _, K in ipairs(self.KeyEntries or {}) do
        if K.Row and K.Key and K.Value then
            local ok, v = pcall(K.Value)
            local txt = (ok and v ~= nil) and tostring(v) or ""
            K.Row.Value.Text = txt ~= "" and ("· " .. txt) or ""
        end
    end
    self:_RefreshKeyVisibility()
end

function Library:_RefreshKeyVisibility()
    if not self.KeyList then return end
    local any = false
    for _, K in ipairs(self.KeyEntries or {}) do
        if K.Row and K.Key then any = true break end
    end
    self.KeyList.Panel.Visible = any and self.Flags.show_keylist ~= false
end

function Library:SetKeybindList(on)
    self.Flags.show_keylist = on and true or false
    self:_RefreshKeyVisibility()
end

