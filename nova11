    btn.MouseEnter:Connect(function()
        if not sub.Active then
            Tween(btn, { BackgroundTransparency = 0.5 }, 0.15)
            Tween(label, { Position = OFF(16, 0) }, 0.2)
        end
    end)
    btn.MouseLeave:Connect(function()
        if not sub.Active then
            Tween(btn, { BackgroundTransparency = 1 }, 0.2)
            Tween(label, { Position = OFF(14, 0) }, 0.25)
        end
    end)

    local page = New("CanvasGroup", {
        Size = UD2(1, 0, 1, 0), BackgroundTransparency = 1, Visible = false,
    }, win.Content)
    Pad(page, 14, 14, 14, 14)

    local colBase = { UD2(0, 0, 0, 0), UD2(0.5, 7, 0, 0) }
    local cols = {}
    for i = 1, 2 do
        local col = New("ScrollingFrame", {
            Size = UD2(0.5, -7, 1, 0),
            Position = colBase[i],
            BackgroundTransparency = 1, ScrollBarThickness = 2,
            CanvasSize = UD2(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollingDirection = Enum.ScrollingDirection.Y,
        }, page)
        lib:Bind(col, "ScrollBarImageColor3", "Stroke")
        Pad(col, 0, 6, 0, 6)
        VList(col, 14)
        cols[i] = col
    end

    sub.Button = btn
    sub.Bar = bar
    sub.Label = label
    sub.Page = page
    sub.Columns = cols
    sub.ColBase = colBase

    btn.MouseButton1Click:Connect(function() win:SelectSub(sub) end)
    table.insert(self.Subs, sub)
    table.insert(win.Subs, sub)

    if not self.Active then
        self.Active = sub
        if win.CurrentGroup == self then win:SelectSub(sub) end
    end
    return sub
end

