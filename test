---------------------------------------------------------------------
function Library:Watermark(o)
    o = o or {}
    local base = tostring(o.Text or "Lib Fac!")
    local frame = New("Frame", {
        AnchorPoint = V2(1, 0), Position = UD2(1, -12, 0, 12), Size = UD2(0, 0, 0, 24),
        AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = self.Theme.Surface, ZIndex = 90,
    }, self.Holder)
    Corner(6, frame)
    self:MakeGlass(frame)
    Stroke(frame, "Stroke", 1, 0.2)
    Pad(frame, 0, 0, 10, 10)
    local label = New("TextLabel", {
        BackgroundTransparency = 1, Size = UD2(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
        Font = FONT, TextSize = 10, ZIndex = 91,
    }, frame)
    self:Bind(label, "TextColor3", "Text")

    local fps, ping, frames, acc = 60, 0, 0, 0
    local function render()
        local parts = { base }
        if o.FPS ~= false then table.insert(parts, math.floor(fps + 0.5) .. " fps") end
        if o.Ping ~= false then table.insert(parts, ping .. " ms") end
        if o.Time ~= false then table.insert(parts, os.date("%H:%M:%S")) end
        label.Text = table.concat(parts, "  |  ")
    end
    self:Connect(RunService.Heartbeat, function(dt)
        frames = frames + 1
        acc = acc + dt
        if acc >= 0.5 then
            fps, frames, acc = frames / acc, 0, 0
            local ok, v = pcall(function()
                return math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue())
            end)
            ping = ok and v or 0
            render()
        end
    end)
    render()
    return frame
end

---------------------------------------------------------------------
-- settings: save / load flags as json
---------------------------------------------------------------------
function Library:GetFlagsTable()
    local out = {}
    for k, v in pairs(self.Flags) do
        if typeof(v) == "Color3" then v = "#" .. v:ToHex() end
        if typeof(v) == "EnumItem" then v = v.Name end
        local t = type(v)
        if t == "string" or t == "number" or t == "boolean" or t == "table" then out[k] = v end
    end
    return out
end

function Library:ApplySettings(data)
    for flag, value in pairs(data) do
        local set = self.Setters[flag]
        if set then pcall(set, value, true) end
    end
    -- settings that act on the window are applied after the flags are set
    self:SetTransparency((self.Flags.ui_transparency or 0) / 100)
    if type(self.Flags.ui_blur) == "boolean" then self:SetBlur(self.Flags.ui_blur) end
    self:_RefreshKeys()
    return true
end

function Library:SettingsDir()
    return self.Folder .. "/Settings"
end

function Library:SaveSetting(name, description)
    if not HasFS or not name or name == "" then return false end
    if not isfolder(self.Folder) then makefolder(self.Folder) end
    if not isfolder(self:SettingsDir()) then makefolder(self:SettingsDir()) end
    local ok, json = pcall(HttpService.JSONEncode, HttpService, {
        meta = { name = name, description = description or "", saved = os.time() },
        flags = self:GetFlagsTable(),
    })
    if not ok then return false end
    writefile(self:SettingsDir() .. "/" .. name .. ".json", json)
    return true
end

function Library:LoadSetting(name)
    if not HasFS or not name or name == "" then return false end
    local path = self:SettingsDir() .. "/" .. name .. ".json"
    if not isfile(path) then return false end
    local ok, data = pcall(HttpService.JSONDecode, HttpService, readfile(path))
    if not ok or type(data) ~= "table" then return false end
    return self:ApplySettings(data.flags or data)
end

function Library:DeleteSetting(name)
    if not HasFS or typeof(delfile) ~= "function" or not name then return false end
    local path = self:SettingsDir() .. "/" .. name .. ".json"
    if not isfile(path) then return false end
    delfile(path)
    return true
end

function Library:ListSettings()
    local out = {}
    if not HasFS or not isfolder(self:SettingsDir()) then return out end
    for _, path in ipairs(listfiles(self:SettingsDir())) do
        local name = tostring(path):match("([^/\\]+)%.json$")
        if name then table.insert(out, name) end
    end
    table.sort(out)
    return out
end

-- the built-in Settings tab
function Library:SettingsTab(win)
    local lib = self
    local tab = win:Tab({ Name = "Settings" })
    local sub = tab:SubTab({ Name = "Manage" })

    local menu = sub:Section({ Name = "Menu" })
    menu:Keybind({
        Name = "Toggle key", Flag = "toggle_key", Default = lib.ToggleKey,
        Callback = function(key, pressed)
            if key and not pressed then lib.ToggleKey = key end
        end,
    })
    menu:Toggle({
        Name = "Show keybind list", Flag = "show_keylist", Default = false,
        Callback = function() lib:_RefreshKeys() end,
    })

    local look = sub:Section({ Name = "Appearance" })
    local trBox
    local trSlider = look:Slider({
        Name = "Window Transparency", Flag = "ui_transparency", Min = 0, Max = 90,
        Default = math.floor(lib.Transparency * 100 + 0.5), Suffix = "%",
        Callback = function(v)
            lib:SetTransparency(v / 100)
            if trBox then trBox.Set(tostring(v), true) end
        end,
    })
    trBox = look:Textbox({
        Name = "Type percent (0 - 90)", Flag = "ui_transparency_text",
        Default = tostring(math.floor(lib.Transparency * 100 + 0.5)), Placeholder = "25",
        Callback = function(text)
            local n = tonumber(text)
            if n then trSlider.Set(math.clamp(n, 0, 90)) end
        end,
    })
    look:Toggle({
        Name = "Background Blur", Flag = "ui_blur", Default = lib.BlurEnabled,
        Callback = function(on) lib:SetBlur(on) end,
    })

    local saveSec = sub:Section({ Name = "Save" })
    local nameBox = saveSec:Textbox({ Name = "Name", Placeholder = "my setting" })

    local loadSec = sub:Section({ Name = "Load", Side = 2 })
    local list = loadSec:Dropdown({ Name = "Setting", Items = lib:ListSettings() })

    saveSec:Button({
        Name = "Save",
        Callback = function()
            local n = nameBox.Get()
            if n == "" then
                lib:Notify({ Title = "Settings", Text = "Enter a name first.", Type = "warning" })
                return
            end
            local ok = lib:SaveSetting(n)
            lib:Notify({
                Title = "Settings", Text = ok and ('Saved "' .. n .. '".') or "Could not save.",
                Type = ok and "success" or "error",
            })
            list.Refresh(lib:ListSettings())
        end,
    })
    loadSec:Button({
        Name = "Load",
        Callback = function()
            local n = list.Get()
            if not n then
                lib:Notify({ Title = "Settings", Text = "Pick a setting first.", Type = "warning" })
                return
            end
            local ok = lib:LoadSetting(n)
            lib:Notify({
                Title = "Settings", Text = ok and ('Loaded "' .. n .. '".') or "Could not load.",
                Type = ok and "success" or "error",
            })
        end,
    })
    loadSec:Button({
        Name = "Delete",
        Callback = function()
            local n = list.Get()
            if not n then
                lib:Notify({ Title = "Settings", Text = "Pick a setting first.", Type = "warning" })
                return
            end
            local ok = lib:DeleteSetting(n)
            list.Refresh(lib:ListSettings())
            lib:Notify({
                Title = "Settings", Text = ok and ('Deleted "' .. n .. '".') or "Could not delete.",
                Type = ok and "info" or "error",
            })
        end,
    })
    loadSec:Button({
        Name = "Refresh list",
        Callback = function() list.Refresh(lib:ListSettings()) end,
    })

    local unload = sub:Section({ Name = "Unload" })
    unload:Label("Closes the menu and removes the script completely.")
    unload:Button({
        Name = "Unload",
        Callback = function()
            lib:Notify({ Title = "Lib Fac!", Text = "Unloading...", Type = "info", Duration = 1 })
            task.delay(0.6, function() lib:Unload() end)
        end,
    })
    return tab
end

---------------------------------------------------------------------
-- sections / groups / subs: the rest of the API
---------------------------------------------------------------------
function Library:Unload()
    for _, c in ipairs(self.Connections) do
        pcall(function() c:Disconnect() end)
    end
    self.Connections = {}
    if self.Blur then pcall(function() self.Blur:Destroy() end) self.Blur = nil end
    if self.Holder then pcall(function() self.Holder:Destroy() end) end
    if genv.LibFac == self then genv.LibFac = nil end
end

genv.LibFac = Library
return Library
