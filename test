---------------------------------------------------------------------
-- helpers
---------------------------------------------------------------------
local function New(class, props, parent)
    local inst = Instance.new(class)
    if inst:IsA("GuiObject") then inst.BorderSizePixel = 0 end
    if props then
        for k, v in pairs(props) do inst[k] = v end
    end
    if parent then inst.Parent = parent end
    return inst
end

local function Corner(r, parent)
    return New("UICorner", { CornerRadius = UD(0, r or 6) }, parent)
end

local function Pad(parent, t, b, l, r)
    return New("UIPadding", {
        PaddingTop = UD(0, t or 0), PaddingBottom = UD(0, b or 0),
        PaddingLeft = UD(0, l or 0), PaddingRight = UD(0, r or 0),
    }, parent)
end

local function VList(parent, gap)
    return New("UIListLayout", { Padding = UD(0, gap or 0), SortOrder = Enum.SortOrder.LayoutOrder }, parent)
end

local function Tween(o, props, t, style, dir)
    local tw = TweenService:Create(o, TweenInfo.new(t or 0.18, style or QUINT, dir or OUT), props)
    tw:Play()
    return tw
end

local function Round(n, dec)
    local m = 10 ^ (dec or 0)
    return math.floor(n * m + 0.5) / m
end

local function Stroke(parent, key, thick, transp)
    local s = New("UIStroke", {
        Thickness = thick or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Transparency = transp or 0,
    }, parent)
    Library:Bind(s, "Color", key or "Stroke")
    return s
end

-- a list item inside a section, numbered in order
local function Item(sec, class, props)
    sec.Count = sec.Count + 1
    props.LayoutOrder = sec.Count
    return New(class, props, sec.Body)
end

---------------------------------------------------------------------
-- theme, transparency and blur
---------------------------------------------------------------------
-- Bind(obj, "Prop", "ThemeKey"): the property follows the theme colour
function Library:Bind(obj, prop, key)
    obj[prop] = self.Theme[key]
    self.Bindings[obj] = self.Bindings[obj] or {}
    self.Bindings[obj][prop] = key
    return obj
end

-- MakeGlass(obj): the background follows the transparency setting
function Library:MakeGlass(obj)
    self.GlassSet[obj] = true
    obj.BackgroundTransparency = self.Transparency
    return obj
end

function Library:SetTheme(key, color)
    self.Theme[key] = color
    for obj, props in pairs(self.Bindings) do
        for prop, k in pairs(props) do
            if k == key then pcall(function() obj[prop] = color end) end
        end
    end
end

function Library:SetAccent(color)
    self:SetTheme("Accent", color)
end

-- fraction from 0 (solid) to 0.9 (almost clear)
function Library:SetTransparency(v)
    self.Transparency = math.clamp(tonumber(v) or 0, 0, 0.9)
    for obj in pairs(self.GlassSet) do
        if obj.Parent then obj.BackgroundTransparency = self.Transparency end
    end
end

function Library:SetBlur(on, size)
    if on ~= nil then self.BlurEnabled = on and true or false end
    if size then self.BlurSize = math.clamp(size, 0, 56) end
    if not self.Blur then
        local ok, b = pcall(function()
            local e = Instance.new("BlurEffect")
            e.Size = 0
            e.Parent = game:GetService("Lighting")
            return e
        end)
        if ok then self.Blur = b end
    end
    if self.Blur then
        Tween(self.Blur, { Size = (self.Visible and self.BlurEnabled) and self.BlurSize or 0 }, 0.25, QUAD)
    end
end

function Library:Connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(self.Connections, c)
    return c
end

function Library:Call(fn, ...)
    if type(fn) ~= "function" then return end
    local ok, err = pcall(fn, ...)
    if not ok then warn("[Lib Fac!] " .. tostring(err)) end
end

function Library:NextFlag()
    self.FlagCount = self.FlagCount + 1
    return "flag_" .. self.FlagCount
end

