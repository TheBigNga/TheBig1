function SectionMT:Colorpicker(o)
    o = o or {}
    local lib = self.Window.Library
    local flag = o.Flag or lib:NextFlag()
    local start = o.Default or lib.Theme.Accent
    local h, s, v = start:ToHSV()
    local color = start

    local holder = Item(self, "Frame", { Size = UD2(1, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 })
    VList(holder, 6)
    local head = New("TextButton", { Size = UD2(1, 0, 0, 20), LayoutOrder = 0, BackgroundTransparency = 1, Text = "", AutoButtonColor = false }, holder)
    local nameL = New("TextLabel", {
        BackgroundTransparency = 1, Size = UD2(1, -40, 1, 0), Text = tostring(o.Name or "Color"),
        Font = FONT_TEXT, TextSize = 13, TextXAlignment = LEFT,
    }, head)
    lib:Bind(nameL, "TextColor3", "Text")
    local swatch = New("Frame", { AnchorPoint = V2(1, 0.5), Position = UD2(1, 0, 0.5, 0), Size = OFF(30, 14), BackgroundColor3 = start }, head)
    Corner(4, swatch)

    local panel = New("Frame", {
        Size = UD2(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
        Visible = false, LayoutOrder = 1,
    }, holder)
    VList(panel, 8)
    local sub = setmetatable({ Window = self.Window, Body = panel, Count = 0 }, SectionMT)

    local function apply(silent)
        color = Color3.fromHSV(h, s, v)
        swatch.BackgroundColor3 = color
        lib.Flags[flag] = color
        if not silent then lib:Call(o.Callback, color) end
    end

    local hue = sub:Slider({ Name = "Hue", NoFlag = true, Min = 0, Max = 360, Default = math.floor(h * 360 + 0.5),
        Callback = function(x) h = x / 360; apply() end })
    local sat = sub:Slider({ Name = "Saturation", NoFlag = true, Min = 0, Max = 100, Suffix = "%",
        Default = math.floor(s * 100 + 0.5), Callback = function(x) s = x / 100; apply() end })
    local val = sub:Slider({ Name = "Brightness", NoFlag = true, Min = 0, Max = 100, Suffix = "%",
        Default = math.floor(v * 100 + 0.5), Callback = function(x) v = x / 100; apply() end })

    head.MouseButton1Click:Connect(function() panel.Visible = not panel.Visible end)
    apply(true)

    local function setColor(c, silent)
        if type(c) == "string" then
            local ok, parsed = pcall(Color3.fromHex, c)
            if not ok then return end
            c = parsed
        end
        if typeof(c) ~= "Color3" then return end
        h, s, v = c:ToHSV()
        hue.Set(math.floor(h * 360 + 0.5), true)
        sat.Set(math.floor(s * 100 + 0.5), true)
        val.Set(math.floor(v * 100 + 0.5), true)
        apply(silent)
    end
    lib.Setters[flag] = function(c, s2) setColor(c, s2) end
    return { Set = function(c, s2) setColor(c, s2) end, Get = function() return color end }
end

---------------------------------------------------------------------
-- search: find main tabs, sub tabs and sections by name
---------------------------------------------------------------------
local KIND_RANK = { group = 3, sub = 2, section = 1 }

function WindowMT:Find(query)
    local q = string.lower(string.match(query or "", "^%s*(.-)%s*$") or "")
    if q == "" then return nil end
    local best, bestRank = nil, -1
    local function consider(kind, name, data)
        local n = string.lower(name or "")
        local score
        if n == q then score = 3
        elseif string.sub(n, 1, #q) == q then score = 2
        elseif string.find(n, q, 1, true) then score = 1
        else return end
        local rank = score * 10 + KIND_RANK[kind]
        if rank > bestRank then
            best, bestRank = { kind = kind, data = data, exact = score == 3 }, rank
        end
    end
    for _, g in ipairs(self.Groups) do consider("group", g.Name, g) end
    for _, s in ipairs(self.Subs) do consider("sub", s.Name, s) end
    for _, s in ipairs(self.Subs) do
        for _, sec in ipairs(s.Sections) do consider("section", sec.Name, sec) end
    end
    return best
end

function WindowMT:Navigate(hit)
    if not hit then return end
    if hit.kind == "group" then
        self:SelectGroup(hit.data)
    elseif hit.kind == "sub" then
        self:SelectGroup(hit.data.Group)
        self:SelectSub(hit.data)
    else
        local sec = hit.data
        self:SelectGroup(sec.Sub.Group)
        self:SelectSub(sec.Sub)
        task.spawn(function()
            task.wait()
            if sec.Card.Parent then
                sec.Column.CanvasPosition = V2(0, math.max(0,
                    sec.Column.CanvasPosition.Y + (sec.Card.AbsolutePosition.Y - sec.Column.AbsolutePosition.Y) - 8))
            end
        end)
    end
end

function Library:Find(q)
    if not self.Window then return nil end
    return self.Window:Find(q)
end

function Library:Navigate(hit)
    if self.Window then self.Window:Navigate(hit) end
end

