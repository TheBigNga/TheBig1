-- shows the keybinds that are set, when the setting is on
function Library:_RefreshKeys()
    local lines = {}
    for _, e in ipairs(self.KeyEntries) do
        if e.Key then table.insert(lines, e.Name .. "   [" .. e.Key.Name .. "]") end
    end
    self.KeyLabel.Text = table.concat(lines, "\n")
    self.KeyPanel.Visible = (#lines > 0) and (self.Flags.show_keylist == true)
end

---------------------------------------------------------------------
-- notifications
---------------------------------------------------------------------
function Library:Notify(o)
    o = o or {}
    local colors = {
        info    = Color3.fromRGB(138, 164, 200),
        success = Color3.fromRGB(74, 222, 128),
        warning = Color3.fromRGB(245, 180, 84),
        error   = Color3.fromRGB(242, 109, 109),
    }
    local accent = colors[o.Type or "info"] or colors.info
    self.NotifCount = self.NotifCount + 1

    local card = New("Frame", {
        Size = UD2(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = self.Theme.Surface, LayoutOrder = self.NotifCount,
    }, self.NotifHolder)
    Corner(8, card)
    self:MakeGlass(card)
    Stroke(card, "Stroke", 1, 0.2)
    Pad(card, 10, 12, 14, 12)
    VList(card, 3)

    New("TextLabel", {
        Size = UD2(1, 0, 0, 16), BackgroundTransparency = 1, LayoutOrder = 1,
        Text = tostring(o.Title or "Lib Fac!"), Font = FONT_BOLD, TextSize = 13,
        TextXAlignment = LEFT, TextColor3 = accent,
    }, card)

    if o.Text then
        local msg = New("TextLabel", {
            Size = UD2(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
            LayoutOrder = 2, Text = tostring(o.Text), Font = FONT_TEXT, TextSize = 12,
            TextWrapped = true, TextXAlignment = LEFT, TextYAlignment = Enum.TextYAlignment.Top,
        }, card)
        self:Bind(msg, "TextColor3", "SubText")
    end

    task.delay(tonumber(o.Duration) or 4, function()
        if card.Parent then card:Destroy() end
    end)
end
Library.Notification = Library.Notify

---------------------------------------------------------------------
-- dragging, visibility, toggle key, loader
---------------------------------------------------------------------
function Library:Draggable(handle, obj)
    local dragging, startMouse, startPos = false, nil, nil
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == MB1 or i.UserInputType == TOUCH then
            dragging, startMouse, startPos = true, i.Position, obj.Position
        end
    end)
    self:Connect(UIS.InputChanged, function(i)
        if dragging and (i.UserInputType == MOVE or i.UserInputType == TOUCH) then
            local d = i.Position - startMouse
            obj.Position = UD2(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    self:Connect(UIS.InputEnded, function(i)
        if i.UserInputType == MB1 or i.UserInputType == TOUCH then dragging = false end
    end)
end

function Library:SetVisible(v)
    self.Visible = v and true or false
    local w = self.Window
    if not w then return end
    if self.Visible then
        w.Main.Visible = true
        Tween(w.Main, { GroupTransparency = 0 }, 0.3, QUAD)
        Tween(w.Scale, { Scale = 1 }, 0.4, BACK)
    else
        Tween(w.Main, { GroupTransparency = 1 }, 0.2, QUAD, IN)
        Tween(w.Scale, { Scale = 0.95 }, 0.2, QUAD, IN)
        task.delay(0.21, function()
            if not self.Visible then w.Main.Visible = false end
        end)
    end
    self:SetBlur()
end

---------------------------------------------------------------------
-- window
---------------------------------------------------------------------
local WindowMT, GroupMT, SubMT, SectionMT = {}, {}, {}, {}
WindowMT.__index = WindowMT
GroupMT.__index = GroupMT
SubMT.__index = SubMT
SectionMT.__index = SectionMT

function Library:Window(opts)
    opts = opts or {}
    local lib = self
    if opts.Keybind and Enum.KeyCode[opts.Keybind] then self.ToggleKey = Enum.KeyCode[opts.Keybind] end
    if opts.Blur ~= nil then self.BlurEnabled = opts.Blur and true or false end
    if opts.BlurSize then self.BlurSize = math.clamp(opts.BlurSize, 0, 56) end
    if opts.Folder then self.Folder = opts.Folder end
    if opts.Accent then self:SetAccent(opts.Accent) end

    local name = tostring(opts.Name or "Lib Fac!")
    local version = tostring(opts.Version or "v6.0")
    local W, H = 640, 430
    if typeof(opts.Size) == "UDim2" then W, H = opts.Size.X.Offset, opts.Size.Y.Offset end
    local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or V2(1280, 720)
    W = math.min(W, vp.X - 40)
    H = math.min(H, vp.Y - 60)

    -- window
    local main = New("CanvasGroup", {
        Name = "Main", AnchorPoint = V2(0.5, 0.5), Position = UD2(0.5, 0, 0.5, 0),
        Size = OFF(W, H), GroupTransparency = 1, ClipsDescendants = true,
        Visible = false, BackgroundColor3 = self.Theme.Background, ZIndex = 1,
    }, self.Holder)
    Corner(10, main)
    self:MakeGlass(main)
    Stroke(main, "Stroke", 1, 0.1)
    local scale = New("UIScale", { Scale = 0.95 }, main)

    -- header: title on the left, status / search / avatar on the right
    local header = New("Frame", {
        Size = UD2(1, 0, 0, HEAD_H), BackgroundColor3 = self.Theme.SectionHead, ZIndex = 3,
    }, main)
    self:MakeGlass(header)

    local title = New("TextLabel", {
        AnchorPoint = V2(0, 0.5), Position = UD2(0, SIDE, 0.5, 0), Size = UD2(0, 220, 0, 20),
        BackgroundTransparency = 1, Text = name .. "  " .. version, Font = FONT_BOLD, TextSize = 15,
        TextXAlignment = LEFT, TextTruncate = TRUNC, ZIndex = 4,
    }, header)
    self:Bind(title, "TextColor3", "Text")

    local right = New("Frame", {
        AnchorPoint = V2(1, 0.5), Position = UD2(1, -14, 0.5, 0), Size = UD2(0, 0, 0, 30),
        AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, ZIndex = 4,
    }, header)
    New("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal, Padding = UD(0, 14),
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder,
    }, right)

    -- status: green dot and text
    local statusBox = New("Frame", {
        LayoutOrder = 1, Size = OFF(0, 16), AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 1, ZIndex = 4,
    }, right)
    New("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal, Padding = UD(0, 6),
        VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder,
    }, statusBox)
    local dot = New("Frame", {
        LayoutOrder = 1, Size = OFF(8, 8), BackgroundColor3 = self.Theme.Online, ZIndex = 4,
    }, statusBox)
    Corner(4, dot)
    local statusLbl = New("TextLabel", {
        LayoutOrder = 2, BackgroundTransparency = 1, Size = OFF(0, 16), AutomaticSize = Enum.AutomaticSize.X,
        Text = tostring(opts.Status or "Online"), Font = FONT_TEXT, TextSize = 13, ZIndex = 4,
    }, statusBox)
    self:Bind(statusLbl, "TextColor3", "SubText")
    self.StatusRefs = { Dot = dot, Label = statusLbl }

    -- search: exact names open straight away, Enter opens the best match
    local search = New("TextBox", {
        LayoutOrder = 2, Size = OFF(200, 28), Text = "", PlaceholderText = "search",
        ClearTextOnFocus = false, Font = FONT_TEXT, TextSize = 12, TextXAlignment = LEFT, ZIndex = 4,
    }, right)
    Corner(6, search)
    Pad(search, 0, 0, 10, 10)
    self:Bind(search, "BackgroundColor3", "Element")
    self:Bind(search, "TextColor3", "Text")
    self:Bind(search, "PlaceholderColor3", "SubText")
    self:MakeGlass(search)
    search:GetPropertyChangedSignal("Text"):Connect(function()
        lib.Flags.search_text = search.Text
        lib:Call(opts.OnSearch, search.Text)
        local hit = search.Text ~= "" and lib:Find(search.Text)
        if hit and hit.exact then
            lib:Navigate(hit)
            search.Text = ""
        end
    end)
    search.FocusLost:Connect(function(enterPressed)
        if not enterPressed then return end
        local typed = search.Text
        local hit = typed ~= "" and lib:Find(typed)
        if hit then
            lib:Navigate(hit)
        elseif typed ~= "" then
            lib:Notify({ Title = "Search", Text = 'Nothing matches "' .. typed .. '".', Type = "warning", Duration = 2 })
        end
        search.Text = ""
        lib.Flags.search_text = ""
    end)

    -- avatar: the logged-in account by default
    local avatarBox = New("Frame", { LayoutOrder = 3, Size = OFF(30, 30), BackgroundColor3 = self.Theme.Element, ZIndex = 4 }, right)
    Corner(15, avatarBox)
    self:Bind(avatarBox, "BackgroundColor3", "Element")
    local avatar = New("ImageLabel", {
        Size = UD2(1, 0, 1, 0), BackgroundTransparency = 1, Image = "",
        ScaleType = Enum.ScaleType.Crop, ZIndex = 5,
    }, avatarBox)
    Corner(15, avatar)
    local prof = opts.Profile or {}
    if prof.Image then
        avatar.Image = tostring(prof.Image)
    else
        task.spawn(function()
            local ok, img = pcall(Players.GetUserThumbnailAsync, Players,
                prof.UserId or LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
            if ok and avatar.Parent and img then avatar.Image = img end
        end)
    end

    New("Frame", { Position = OFF(0, HEAD_H), Size = UD2(1, 0, 0, 1), ZIndex = 3, BackgroundColor3 = self.Theme.Stroke }, main)

    -- main tab row
    local navRow = New("Frame", {
        Position = OFF(SIDE, NAV_Y), Size = UD2(1, -SIDE * 2, 0, NAV_H), BackgroundTransparency = 1, ZIndex = 2,
    }, main)
    New("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal, Padding = UD(0, 4),
        VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder,
    }, navRow)
    New("Frame", { Position = OFF(0, NAV_Y + NAV_H), Size = UD2(1, 0, 0, 1), ZIndex = 2, BackgroundColor3 = self.Theme.Stroke }, main)

    -- sub tab pill row (only the pill of the selected main tab is shown)
    local pillRow = New("Frame", {
        Position = OFF(SIDE, PILL_Y), Size = UD2(1, -SIDE * 2, 0, PILL_H), BackgroundTransparency = 1, ZIndex = 2,
    }, main)

    -- content: the sections page
    local content = New("Frame", {
        Position = OFF(0, CONTENT_Y), Size = UD2(1, 0, 1, -CONTENT_Y),
        BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 2,
    }, main)

    -- loader
    local loadTime = opts.LoadTime or 1.0
    local loader = New("CanvasGroup", {
        Size = UD2(1, 0, 1, 0), GroupTransparency = 0, BackgroundColor3 = self.Theme.Background, ZIndex = 50,
    }, main)
    local lt = New("TextLabel", {
        AnchorPoint = V2(0.5, 0.5), Position = UD2(0.5, 0, 0.5, -10), Size = OFF(300, 20),
        BackgroundTransparency = 1, Text = string.lower(name), Font = FONT_BOLD, TextSize = 15,
    }, loader)
    self:Bind(lt, "TextColor3", "Text")
    local track = New("Frame", {
        AnchorPoint = V2(0.5, 0.5), Position = UD2(0.5, 0, 0.5, 14), Size = OFF(180, 2),
        BackgroundColor3 = self.Theme.Element,
    }, loader)
    local fill = New("Frame", { Size = UD2(0, 0, 1, 0), BackgroundColor3 = self.Theme.Accent }, track)
    Tween(fill, { Size = UD2(1, 0, 1, 0) }, loadTime, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
    task.delay(loadTime + 0.2, function()
        if loader.Parent then
            Tween(loader, { GroupTransparency = 1 }, 0.4, QUAD)
            task.delay(0.45, function()
                if loader.Parent then loader:Destroy() end
            end)
        end
    end)

    local win = setmetatable({
        Library = self, Name = name, Main = main, Scale = scale,
        NavRow = navRow, PillRow = pillRow, Content = content,
        Groups = {}, Subs = {},
    }, WindowMT)
    self.Window = win

    self:Draggable(header, main)
    self:Connect(UIS.InputBegan, function(input, processed)
        if processed then return end
        if input.KeyCode == lib.ToggleKey then lib:SetVisible(not lib.Visible) end
    end)

    -- mobile toggle button
    if UIS.TouchEnabled and not UIS.KeyboardEnabled then
        local tb = New("TextButton", {
            Position = OFF(12, 12), Size = OFF(36, 36), Text = string.upper(string.sub(name, 1, 1)),
            Font = FONT_BOLD, TextSize = 16, AutoButtonColor = false, ZIndex = 60, BackgroundColor3 = self.Theme.Surface,
        }, self.Holder)
        Corner(8, tb)
        self:Bind(tb, "TextColor3", "Accent")
        tb.MouseButton1Click:Connect(function() lib:SetVisible(not lib.Visible) end)
    end

    task.defer(function() lib:SetVisible(true) end)
    return win
end

---------------------------------------------------------------------
-- main tabs
---------------------------------------------------------------------
function WindowMT:Tab(o)
    o = o or {}
    local lib = self.Library
    local g = setmetatable({
        Window = self, Name = tostring(o.Name or "Tab"), Subs = {},
        Selected = false, Active = nil, Cursor = 4,
    }, GroupMT)

    local btn = New("TextButton", {
        AutomaticSize = Enum.AutomaticSize.X, Size = OFF(0, NAV_H), BackgroundTransparency = 1,
        Text = g.Name, Font = FONT_BOLD, TextSize = 13, AutoButtonColor = false,
        LayoutOrder = #self.Groups + 1, ZIndex = 3,
    }, self.NavRow)
    Pad(btn, 0, 0, 12, 12)
    lib:Bind(btn, "TextColor3", "SubText")

    -- accent underline under the selected main tab
    local bar = New("Frame", {
        AnchorPoint = V2(0.5, 1), Position = UD2(0.5, 0, 1, 0), Size = UD2(1, -24, 0, 2),
        BackgroundTransparency = 1, ZIndex = 3,
    }, btn)
    lib:Bind(bar, "BackgroundColor3", "Accent")
    Corner(1, bar)

    -- the pill that holds this tab's sub tabs
    local pill = New("Frame", { Size = OFF(4, PILL_H), Visible = false, ZIndex = 2 }, self.PillRow)
    Corner(6, pill)
    lib:Bind(pill, "BackgroundColor3", "Element")
    lib:MakeGlass(pill)
    local hl = New("Frame", { Position = OFF(4, 4), Size = OFF(0, PILL_H - 8), ZIndex = 2 }, pill)
    Corner(4, hl)
    lib:Bind(hl, "BackgroundColor3", "ElementHover")

    g.Button, g.Label, g.Bar, g.Pill, g.Highlight = btn, btn, bar, pill, hl
    table.insert(self.Groups, g)

    btn.MouseEnter:Connect(function()
        if not g.Selected then Tween(btn, { TextColor3 = lib.Theme.Text }, 0.15) end
    end)
    btn.MouseLeave:Connect(function()
        if not g.Selected then Tween(btn, { TextColor3 = lib.Theme.SubText }, 0.2) end
    end)
    btn.MouseButton1Click:Connect(function() self:SelectGroup(g) end)

    if not self.CurrentGroup then self:SelectGroup(g) end
    return g
end

function WindowMT:SelectGroup(g)
    local lib = self.Library
    self.CurrentGroup = g
    for _, o in ipairs(self.Groups) do
        local on = o == g
        o.Selected = on
        o.Pill.Visible = on
        Tween(o.Label, { TextColor3 = on and lib.Theme.Text or lib.Theme.SubText }, 0.25)
        Tween(o.Bar, { BackgroundTransparency = on and 0 or 1 }, 0.25)
    end
    local target = g.Active or g.Subs[1]
    if target then self:SelectSub(target) end
end

---------------------------------------------------------------------
-- sub tabs (inside the pill)
---------------------------------------------------------------------
function WindowMT:SelectSub(s)
    local lib = self.Library
    self.CurrentSub = s
    s.Group.Active = s
    for _, o in ipairs(self.Subs) do
        local on = o == s
        o.Active = on
        o.Page.Visible = on
        Tween(o.Button, { TextColor3 = on and lib.Theme.Text or lib.Theme.SubText }, 0.25)
    end
    local hl = s.Group.Highlight
    local pos, size = OFF(s.X, 4), OFF(s.W, PILL_H - 8)
    if hl.Size.X.Offset == 0 then
        hl.Position = pos
        hl.Size = size
    else
        Tween(hl, { Position = pos, Size = size }, 0.3, QUINT)
    end
end

function GroupMT:SubTab(o)
    o = o or {}
    local win = self.Window
    local lib = win.Library

    local s = setmetatable({
        Window = win, Group = self, Name = tostring(o.Name or "Sub"),
        Sections = {}, Count = { 0, 0 }, Active = false,
    }, SubMT)

    -- position inside the pill, computed from the text width
    local textW = TextService:GetTextSize(s.Name, 12, FONT_TEXT, V2(1000, 100)).X
    s.W = math.floor(textW + 24)
    s.X = self.Cursor
    self.Cursor = s.X + s.W + 2
    self.Pill.Size = OFF(self.Cursor + 2, PILL_H)

    local btn = New("TextButton", {
        Position = OFF(s.X, 4), Size = OFF(s.W, PILL_H - 8), BackgroundTransparency = 1,
        Text = s.Name, Font = FONT_TEXT, TextSize = 12, AutoButtonColor = false, ZIndex = 3,
    }, self.Pill)
    lib:Bind(btn, "TextColor3", "SubText")
    s.Button = btn

    -- page: two columns of sections
    local page = New("Frame", {
        Position = OFF(SIDE, 0), Size = UD2(1, -SIDE * 2, 1, 0),
        BackgroundTransparency = 1, Visible = false, ZIndex = 2,
    }, win.Content)
    s.Page = page
    s.Columns = {}
    for i = 1, 2 do
        local col = New("ScrollingFrame", {
            Position = i == 1 and UD2(0, 0, 0, 0) or UD2(0.5, 7, 0, 0),
            Size = UD2(0.5, -7, 1, -6), BackgroundTransparency = 1, ScrollBarThickness = 2,
            CanvasSize = UD2(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollingDirection = Enum.ScrollingDirection.Y,
        }, page)
        lib:Bind(col, "ScrollBarImageColor3", "Stroke")
        Pad(col, 0, 6, 0, 6)
        VList(col, 14)
        s.Columns[i] = col
    end

    btn.MouseEnter:Connect(function()
        if not s.Active then Tween(btn, { TextColor3 = lib.Theme.Text }, 0.15) end
    end)
    btn.MouseLeave:Connect(function()
        if not s.Active then Tween(btn, { TextColor3 = lib.Theme.SubText }, 0.2) end
    end)
    btn.MouseButton1Click:Connect(function() win:SelectSub(s) end)

    table.insert(self.Subs, s)
    table.insert(win.Subs, s)
    if not self.Active then
        self.Active = s
        if win.CurrentGroup == self then win:SelectSub(s) end
    end
    return s
end

