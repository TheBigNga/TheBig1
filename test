        Font = FONT_TEXT, TextSize = 13, TextXAlignment = LEFT,
    }, row)
    lib:Bind(label, "TextColor3", "Text")
    local btn = New("TextButton", {
        AnchorPoint = V2(1, 0.5), Position = UD2(1, 0, 0.5, 0), Size = OFF(90, 22),
        Text = "none", Font = FONT, TextSize = 10, AutoButtonColor = false,
    }, row)
    Corner(6, btn)
    lib:Bind(btn, "BackgroundColor3", "Element")
    lib:Bind(btn, "TextColor3", "SubText")
    lib:MakeGlass(btn)

    local entry = { Name = tostring(o.Name or "Keybind"), Key = nil }
    table.insert(lib.KeyEntries, entry)
    local waiting = false
    local callback = o.Callback

    local function set(key, silent)
        if type(key) == "string" then key = Enum.KeyCode[key] end
        entry.Key = typeof(key) == "EnumItem" and key or nil
        lib.Flags[flag] = entry.Key and entry.Key.Name or nil
        btn.Text = entry.Key and entry.Key.Name or "none"
        lib:_RefreshKeys()
        if not silent then lib:Call(callback, entry.Key) end
    end

    btn.MouseButton1Click:Connect(function()
        waiting = true
        btn.Text = "press key"
    end)
    lib:Connect(UIS.InputBegan, function(input, processed)
        if waiting then
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            waiting = false
            if input.KeyCode == Enum.KeyCode.Escape then set(nil) else set(input.KeyCode) end
            return
        end
        if not processed and entry.Key and input.KeyCode == entry.Key then
            lib:Call(callback, entry.Key, true)
        end
    end)

    set(o.Default, true)
    lib.Setters[flag] = function(v, s) set(v, s) end
    return { Set = function(v, s) set(v, s) end, Get = function() return entry.Key end }
end

function SectionMT:Slider(o)
    o = o or {}
    local lib = self.Window.Library
    local flag = (not o.NoFlag) and (o.Flag or lib:NextFlag()) or nil
    local min, max = o.Min or 0, o.Max or 100
    local dec = o.Decimals or 0
    local suffix = o.Suffix or ""

    local holder = Item(self, "Frame", { Size = UD2(1, 0, 0, 34), BackgroundTransparency = 1 })
    local nameL = New("TextLabel", {
        BackgroundTransparency = 1, Size = UD2(1, -60, 0, 14), Text = tostring(o.Name or "Slider"),
        Font = FONT_TEXT, TextSize = 13, TextXAlignment = LEFT, TextTruncate = TRUNC,
    }, holder)
    lib:Bind(nameL, "TextColor3", "Text")
    local valL = New("TextLabel", {
        BackgroundTransparency = 1, AnchorPoint = V2(1, 0), Position = UD2(1, 0, 0, 0),
        Size = OFF(60, 14), Font = FONT, TextSize = 10, TextXAlignment = RIGHT,
    }, holder)
    lib:Bind(valL, "TextColor3", "SubText")
    local track = New("Frame", { Position = OFF(0, 22), Size = UD2(1, 0, 0, 3) }, holder)
    lib:Bind(track, "BackgroundColor3", "Element")
    Corner(2, track)
    local fill = New("Frame", { Size = UD2(0, 0, 1, 0) }, track)
    lib:Bind(fill, "BackgroundColor3", "Accent")
    Corner(2, fill)
    local knob = New("Frame", { AnchorPoint = V2(0.5, 0.5), Position = UD2(0, 0, 0.5, 0), Size = OFF(10, 10), ZIndex = 3 }, track)
    Corner(5, knob)
    lib:Bind(knob, "BackgroundColor3", "Text")
    local hit = New("TextButton", {
        BackgroundTransparency = 1, Position = OFF(0, -9), Size = UD2(1, 0, 0, 21),
        Text = "", AutoButtonColor = false, ZIndex = 4,
    }, track)

    local value = min
    local function set(v, silent)
        value = Round(math.clamp(tonumber(v) or min, min, max), dec)
        local pct = max == min and 0 or (value - min) / (max - min)
        Tween(fill, { Size = UD2(pct, 0, 1, 0) }, 0.15)
        Tween(knob, { Position = UD2(pct, 0, 0.5, 0) }, 0.15)
        valL.Text = string.format("%." .. dec .. "f", value) .. suffix
        if flag then lib.Flags[flag] = value end
        if not silent then lib:Call(o.Callback, value) end
    end

    local sliding = false
    local function fromX(x)
        local w = track.AbsoluteSize.X
        if w <= 0 then return end
        set(min + (max - min) * math.clamp((x - track.AbsolutePosition.X) / w, 0, 1))
    end
    hit.InputBegan:Connect(function(i)
        if i.UserInputType == MB1 or i.UserInputType == TOUCH then
            sliding = true
            fromX(i.Position.X)
        end
    end)
    lib:Connect(UIS.InputChanged, function(i)
        if sliding and (i.UserInputType == MOVE or i.UserInputType == TOUCH) then fromX(i.Position.X) end
    end)
    lib:Connect(UIS.InputEnded, function(i)
        if i.UserInputType == MB1 or i.UserInputType == TOUCH then sliding = false end
    end)

    set(o.Default or min, true)
    if flag then lib.Setters[flag] = function(v, s) set(v, s) end end
    return { Set = function(v, s) set(v, s) end, Get = function() return value end }
end

function SectionMT:Dropdown(o)
    o = o or {}
    local lib = self.Window.Library
    local flag = o.Flag or lib:NextFlag()
    local multi = o.Multi and true or false
    local value = multi and {} or nil
    local has, items, open = {}, {}, false

    local holder = Item(self, "Frame", { Size = UD2(1, 0, 0, 28), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 })
    VList(holder, 4)
    local head = New("TextButton", { Size = UD2(1, 0, 0, 28), LayoutOrder = 0, Text = "", AutoButtonColor = false }, holder)
    Corner(6, head)
    lib:Bind(head, "BackgroundColor3", "Element")
    lib:MakeGlass(head)
    local nameL = New("TextLabel", {
        BackgroundTransparency = 1, Position = OFF(10, 0), Size = UD2(0.5, -10, 1, 0),
        Text = tostring(o.Name or "Select"), Font = FONT_TEXT, TextSize = 13, TextXAlignment = LEFT, TextTruncate = TRUNC,
    }, head)
    lib:Bind(nameL, "TextColor3", "Text")
    local valL = New("TextLabel", {
        BackgroundTransparency = 1, Position = UD2(0.5, 0, 0, 0), Size = UD2(0.5, -30, 1, 0),
        Text = "None", Font = FONT, TextSize = 10, TextXAlignment = RIGHT, TextTruncate = TRUNC,
    }, head)
    lib:Bind(valL, "TextColor3", "SubText")
    local arrow = New("TextLabel", {
        BackgroundTransparency = 1, AnchorPoint = V2(1, 0.5), Position = UD2(1, -10, 0.5, 0),
        Size = OFF(12, 12), Text = "v", Font = FONT_BOLD, TextSize = 12,
    }, head)
    lib:Bind(arrow, "TextColor3", "SubText")
    local list = New("Frame", {
        Size = UD2(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
        Visible = false, LayoutOrder = 1,
    }, holder)
    VList(list, 2)

    local function isSel(n)
        if multi then return table.find(value, n) ~= nil end
        return value == n
    end

    local function paint()
        if multi then
            local n = #value
            if n == 0 then valL.Text = "None"
            elseif n == 1 then valL.Text = value[1]
            else valL.Text = n .. " selected" end
        else
            valL.Text = value ~= nil and tostring(value) or "None"
        end
        for _, it in ipairs(items) do
            local on = isSel(it.Name)
            Tween(it.Label, { TextColor3 = on and lib.Theme.Text or lib.Theme.SubText }, 0.2)
            Tween(it.Mark, { BackgroundTransparency = on and 0 or 1 }, 0.2)
        end
    end

    local function setValue(v, silent)
        if multi then
            value = {}
            if type(v) == "table" then
                for _, x in ipairs(v) do
                    if has[x] then table.insert(value, x) end
                end
            end
        else
            value = (v ~= nil and has[v]) and v or nil
        end
        paint()
        lib.Flags[flag] = multi and table.clone(value) or value
        if not silent then lib:Call(o.Callback, lib.Flags[flag]) end
    end

    local function add(n)
        n = tostring(n)
        if has[n] then return end
        has[n] = true
        local b = New("TextButton", {
            Size = UD2(1, 0, 0, 24), BackgroundTransparency = 1, Text = "",
            AutoButtonColor = false, LayoutOrder = #items + 1,
        }, list)
        local lbl = New("TextLabel", {
            BackgroundTransparency = 1, Position = OFF(10, 0), Size = UD2(1, -30, 1, 0),
            Text = n, Font = FONT_TEXT, TextSize = 13, TextXAlignment = LEFT,
        }, b)
        lib:Bind(lbl, "TextColor3", "SubText")
        local mark = New("Frame", {
            AnchorPoint = V2(1, 0.5), Position = UD2(1, -10, 0.5, 0), Size = OFF(6, 6), BackgroundTransparency = 1,
        }, b)
        Corner(3, mark)
        lib:Bind(mark, "BackgroundColor3", "Accent")
        b.MouseButton1Click:Connect(function()
            if multi then
                local idx = table.find(value, n)
                if idx then table.remove(value, idx) else table.insert(value, n) end
                setValue(value)
            else
                open = false
                list.Visible = false
                setValue(n)
            end
        end)
        table.insert(items, { Name = n, Button = b, Label = lbl, Mark = mark })
        paint()
    end

    local function clear()
        for _, it in ipairs(items) do it.Button:Destroy() end
        items, has = {}, {}
    end

    head.MouseButton1Click:Connect(function()
        open = not open
        list.Visible = open
        Tween(arrow, { Rotation = open and 180 or 0 }, 0.2)
    end)

    for _, item in ipairs(o.Items or {}) do add(item) end
    setValue(o.Default, true)
    lib.Setters[flag] = function(v, s) setValue(v, s) end

    return {
        Set = function(v, s) setValue(v, s) end,
        Get = function() return value end,
        Refresh = function(newItems)
            local keep = multi and table.clone(value) or value
            clear()
            for _, it in ipairs(newItems or {}) do add(it) end
            setValue(keep, true)
        end,
    }
end

